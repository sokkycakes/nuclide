#include "ui/menudef.h"


{
\\ INGAME_JOIN MENU \\

  menuDef {
    	name "ingame_join"
    	visible 1
    	fullScreen 0
	outOfBoundsClick			// this closes the window if it gets a click out of the rectangle
    	rect 121 78 128 128
	focusColor 1 .75 0 1


itemDef {
	name window
	rect 4 10 120 108
	style 1
	backcolor 0 0 0 0.8
	visible 1
	decoration
	}
itemDef {
	name window
	rect 5 14 118 102
	style 1
	backcolor 1 1 1 0.12
	background "ui/assets/menu/fade.tga"
	visible 1
	decoration
	}


