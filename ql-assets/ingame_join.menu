itemDef {
     	name team
     	text "Team RED"
	type 1
      	style 2	
     	rect 0 40 128 20   
     	textalign 1	
     	textalignx 64
    	textaligny 18        
	textscale .25
      	forecolor 1 1 1 1
      	visible 1 
      	action { exec "cmd team red" ; uiScript closeingame }
    	}

 itemDef {
      	name team
      	text "Team BLUE"
	type 1
      	style 2	
      	rect 0 60 128 20   
      	textalign 1	
      	textalignx 64
      	textaligny 18
	textscale .25
      	forecolor  1 1 1 1
      	visible 1 
      	action { exec "cmd team blue" ; uiScript closeingame }
    	}
 

