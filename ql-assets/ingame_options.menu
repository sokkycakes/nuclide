//	BUTTON TEXT

	itemDef {
		name btn1t
		text "BASIC"
		textscale .18
		style 1	
		rect 160 3 66 12 
		backcolor 0.2 0.2 0.2 1
		forecolor 1 0.4 0.2 1
		//border 1
		//bordercolor .3 .3 .3 1
		textalign 1
		textalignx 32      
      		textaligny 9
		decoration
		visible 1 	  
    	}
	itemDef {
		name btn2t
		text "ADVANCED"
		textscale .18
		style 1	
		rect 228 3 66 12 
		backcolor 0 0 0 0
		forecolor 0.6 0.6 0.6 1
		textalign 1
		textalignx 32      
      		textaligny 9
		decoration
		visible 1 	  
    	}

itemDef {
	name btn1
	type 1
	group grpControlbutton
	style WINDOW_STYLE_FILLED
	rect 160 0 66 18
	backcolor 0 0 0 0
	visible 1
	action { hide grpControls ; show basic
	 setitemcolor btn1t backcolor 0.2 0.2 0.2 1
	 setitemcolor btn1t forecolor 1 0.4 0.2 1
	 setitemcolor btn2t backcolor 0 0 0 0
	 setitemcolor btn2t forecolor 0.6 0.6 0.6 1
	 transition railSlider 417 124 220 20 417 124 220 20 0.1 ;
	}
	onFocus {
			transition btn1t 161 3 66 12 160 3 66 12 20 10
		}
	}

itemDef {
	name btn2
	type 1
	group grpControlbutton
	style WINDOW_STYLE_FILLED
	rect 228 0 66 18
	backcolor 0 0 0 0
	visible 1
	action { hide grpControls ; show advanced 
	 setitemcolor btn2t backcolor 0.2 0.2 0.2 1
	 setitemcolor btn2t forecolor 1 0.4 0.2 1
	 setitemcolor btn1t backcolor 0 0 0 0
	 setitemcolor btn1t forecolor 0.6 0.6 0.6 1
	 transition railSlider 650 135 220 12 417 650 220 12 0.1 ;
	}
	onFocus {
			transition btn2t 229 3 66 12 228 3 66 12 20 10
		}
	}

