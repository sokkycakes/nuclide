\\ SETUP MENU \\

menuDef {
    	name "ingame_options"
    	visible 0
    	fullscreen 0
    	rect -1 129 640 351
    	focusColor 1 .75 0 1
    	style 1
    	border 1
    	disableColor .5 .5 .5 1

	onopen { hide grpControls ; show basic
	 setitemcolor btn1t backcolor 0.2 0.2 0.2 1
	 setitemcolor btn1t forecolor 1 0.4 0.2 1
	 setitemcolor btn2t backcolor 0 0 0 0
	 setitemcolor btn2t forecolor 0.6 0.6 0.6 1
	 transition railSlider 417 124 220 12 417 124 220 12 0.1 ;
	}

