#include "ui/menudef.h"

{
\\ END OF GAME \\

menuDef {
	name "error_popmenu"
   	visible 0
   	fullscreen 0
   	rect 0 -15 320 250
	focusColor 1 .75 0 1
   	style 1
   	border 1
	popup



itemDef {
	name window
	rect 118 140 400 200
	style 1
	backcolor .8 .1 .0 1
	forecolor 0 0 0 1
	visible 1
	decoration
	}

itemDef {
	name window
	rect 118 140 400 200//168 15 300 200
	style 3
	background "warning"
	forecolor 0 0 0 1
	visible 1
	decoration
	}

itemDef {
	name window
	rect 138 155 350 160
	style 1
	backcolor .4 .1 .0 1
	forecolor 0 0 0 1
	border 1
	bordercolor 0 0 0 1
	bordersize 5
	visible 1
	decoration
	}

   

	itemDef {
		name errorinfo
		rect 158 170 300 20	
		text "Error:"
		textalign 1
		textstyle 6
		textscale .333
		textalignx 160
		textaligny 23
		forecolor 1 1 1 1
		visible 1
		decoration
	}
	
	itemDef {
		name errorinfo
		rect 208 200 280 150
		type ITEM_TYPE_TEXT
		style 1
		textstyle 3
		autowrapped
		cvar "com_errorMessage"
		textalign ITEM_ALIGN_CENTER
		textalignx 100
		textaligny 23
		textscale .25
		forecolor 1 1 1 1
		visible 1
		decoration
	}
 








//	QUIT	//

itemDef {
      	name quitbar
      	style 2
      	rect -1 418 640 30 
      	backcolor 0.5 0.1 0 .25
      	border 4
      	bordercolor 0.5 0.5 0.5 1
      	bordersize 1
      	visible 1 
      	decoration 
    	}
itemDef {
      	name quit
      	text "QUIT"
      	style 0	
	type 1
	textstyle 6
      	rect -1 418 640 30
	textalignx 320
	textaligny 24 
	textscale .416
      	textalign 1	   
   	forecolor 1 1 1 1
      	visible 1 
	action { play "sound/misc/nomenu.wav" ; 
	close main ;
	close error_popmenu ; 
	uiScript "quit" }
	mouseEnter { setitemcolor quitbar backcolor .75 0 0 .25 }
      	mouseExit { setitemcolor quitbar backcolor 0.5 0.1 0 .25 }
   	}
