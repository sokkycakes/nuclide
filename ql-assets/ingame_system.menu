itemDef {
	name ctr_driver
	text "DRIVER INFO"
	type 1
	textscale .22
	group grpControlbutton
	style WINDOW_STYLE_FILLED
	border 1
	bordercolor .5 .5 .5 1
	rect 118 49 64 20
	textalign 1
	textalignx 32
	textaligny 14
	forecolor 1 1 1 1
	backcolor .37 .1 .1 0 
	visible 1
	action { hide grpSystem ; show driver 
	 setitemcolor ctr_graphics backcolor .37 .1 .1 0
	 setitemcolor ctr_driver backcolor .37 .1 .1 1
	 setitemcolor ctr_other backcolor .37 .1 .1 0
	}
	}


 	
	itemDef {
		name driver
		group grpSystem
		rect 18 83 276 228	
		ownerdraw UI_GLINFO 
		textalign 1
		textscale .15
		textalignx 0
		textaligny 6
		forecolor 1 1 1 1
		visible 0
		decoration
	}

