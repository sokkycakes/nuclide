	}

itemDef {
	name ctr_graphics
	text "GRAPHICS"
	type 1
	textscale .22
	group grpControlbutton
	style WINDOW_STYLE_FILLED
	border 1
	bordercolor .5 .5 .5 1
	rect 43 49 64 20
	textalign 1
	textalignx 32
	textaligny 14
	forecolor 1 1 1 1
	backcolor .37 .1 .1 0 
	visible 1
	action { hide grpSystem ; show graphics 
	 setitemcolor ctr_graphics backcolor .37 .1 .1 1
	 setitemcolor ctr_driver backcolor .37 .1 .1 0
	 setitemcolor ctr_other backcolor .37 .1 .1 0
	}
	}


	itemDef {
      		name graphics
		group grpSystem
      	 	type ITEM_TYPE_YESNO
		text "Fullscreen:"
