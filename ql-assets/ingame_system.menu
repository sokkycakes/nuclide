\\ SYSTEM MENU \\

menuDef {
    	name "ingame_system"
    	visible 0
    	fullscreen 0
    	rect 121 37 300 326
    	focusColor 1 .75 0 1
    	style 1
    	border 1
	onopen { hide grpsystem ; show graphics 
	 setitemcolor ctr_graphics backcolor .37 .1 .1 1
	 setitemcolor ctr_driver backcolor .37 .1 .1 0
	 setitemcolor ctr_other backcolor .37 .1 .1 0
	}

