itemDef {
	name graphics
	text "Apply"
	type 1
	textscale .25
	group grpsystem
	style WINDOW_STYLE_FILLED
	background "ui/assets/button_back.tga"
	rect 115 275 75 20
	textalign 1
	textalignx 37
	textaligny 15
	forecolor 1 1 1 1
	backcolor .37 .1 .1 1 
	visible 0
	action { exec "vid_restart" }
	mouseEnter { setcolor backcolor .1 .37 .1 1 }
      	mouseExit { setcolor backcolor .37 .1 .1 1 }
	}


