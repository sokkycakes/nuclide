//AD CONTENT
// advert showing at the end of the game 4x1, 256x64, ~5% of screen
itemdef {
	name pauseAdvert
	ownerdraw UI_ADVERT
   	rect 220 375 200 50
   	style 3
    defaultContent "textures/ad_content/ad4x1.jpg"
   	cellId 1
	forecolor 1 1 1 1.0
   	visible 1
	}
