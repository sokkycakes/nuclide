	      	rect 69 95 10 10
	      	background "ui/assets/score/arrow.tga"
		style 3 
	      	visible 1 
	      	decoration 
	}
	//title
	itemDef {
		name mapname
		text "GAME MENU"
		textscale .2
		style 0	
		rect 82 104 418 10 
		textalign 0		
		backcolor 0 0 0 0
		forecolor 0.8 0.8 0.8 1
		visible 1 
		decoration	  
	}
//TOP NAV
    // current match
	itemdef {
		name navbtn1
      		rect 72 108 94 25
      		background "ui/assets/score/btn.tga"
		style 1 
	      	visible 1 
	      	type 1
		action { open ingame_about
		 setitemcolor navbtn1o backcolor 1 1 1 1
		 setitemcolor navbtn2o backcolor 1 1 1 0
		 setitemcolor navbtn3o backcolor 1 1 1 0
		 setitemcolor navbtn4o backcolor 1 1 1 0
		 setitemcolor navbtn5o backcolor 1 1 1 0
		}
		onFocus {
		transition navbtn1t 80 108 80 20 79 108 80 20 20 10
		}
	      	backcolor 1 1 1 0.2
	}
	itemdef {
		name navbtn1o
      		rect 72 108 94 25
      		background "ui/assets/score/btno.tga"
		style 1 
	      	visible 1 
	      	decoration 
	      	backcolor 1 1 1 1
	}
	itemDef {
		name navbtn1t
		text "CURRENT MATCH"
		textscale .18
		style 0	
		rect 79 108 80 20
      		textalignx 40      
      		textaligny 14
		textalign 1		
		forecolor 1 1 1 1
		visible 1 
		decoration
	}
    // controls
	itemdef {
		name navbtn2
      		rect 167 108 94 25
      		background "ui/assets/score/btn.tga"
		style 1 
	      	visible 1 
	      	type 1
		action { open ingame_controls
		 setitemcolor navbtn1o backcolor 1 1 1 0
		 setitemcolor navbtn2o backcolor 1 1 1 1
		 setitemcolor navbtn3o backcolor 1 1 1 0
		 setitemcolor navbtn4o backcolor 1 1 1 0
		 setitemcolor navbtn5o backcolor 1 1 1 0
		}
		onFocus {
		transition navbtn2t 175 108 80 20 174 108 80 20 20 10
		}
	      	backcolor 1 1 1 0.2
	}
	itemdef {
		name navbtn2o
      		rect 167 108 94 25
      		background "ui/assets/score/btno.tga"
		style 1 
	      	visible 1 
	      	decoration 
	      	backcolor 1 1 1 0
	}
	itemDef {
		name navbtn2t
		text "CONTROLS"
		textscale .18
		style 0	
		rect 174 108 80 20
      		textalignx 40      
      		textaligny 14 
		textalign 1		
		forecolor 1 1 1 1
		visible 1 
		
		decoration
	}
    // game settings
	itemdef {
		name navbtn3
      		rect 262 108 94 25
      		background "ui/assets/score/btn.tga"
		style 1
	      	visible 1 
		type 1
		action { open ingame_options
		 setitemcolor navbtn1o backcolor 1 1 1 0
		 setitemcolor navbtn2o backcolor 1 1 1 0
		 setitemcolor navbtn3o backcolor 1 1 1 1
		 setitemcolor navbtn4o backcolor 1 1 1 0
		 setitemcolor navbtn5o backcolor 1 1 1 0
		}
		onFocus {
		transition navbtn3t 270 108 80 20 269 108 80 20 20 10
		}
	      	backcolor 1 1 1 0.2
	}
	itemdef {
		name navbtn3o
      		rect 262 108 94 25
      		background "ui/assets/score/btno.tga"
		style 1 
	      	visible 1 
	      	decoration 
	      	backcolor 1 1 1 0
	}
	itemDef {
		name navbtn3t
		text "GAME SETTINGS"
		textscale .18
		style 0	
		rect 269 108 80 20
      		textalignx 40      
      		textaligny 14
		textalign 1		
		forecolor 1 1 1 1
		visible 1 
		decoration
	}
    // call vote
	itemdef {
		name navbtn4
      		rect 357 108 94 25
      		background "ui/assets/score/btn.tga"
		style 1 
	      	visible 1 
		type 1
		cvarTest "ui_voteactive"
		showCvar { "0" }
		action { open ingame_callvote
		 setitemcolor navbtn1o backcolor 1 1 1 0
		 setitemcolor navbtn2o backcolor 1 1 1 0
		 setitemcolor navbtn3o backcolor 1 1 1 0
		 setitemcolor navbtn4o backcolor 1 1 1 1
		 setitemcolor navbtn5o backcolor 1 1 1 0
		}
		onFocus {
		transition navbtn4t 365 108 80 20 364 108 80 20 20 10
		}
	      	backcolor 1 1 1 0.2
	}
