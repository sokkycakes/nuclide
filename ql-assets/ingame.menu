//	ADVERTS	 //
itemDef {
  	name adbg
  	rect 218 373 204 54
	style WINDOW_STYLE_FILLED
	//border 1
	//bordercolor 0 0 0 .75
	forecolor 1 1 1 1
	backcolor 0 0 0 .75//.3 .3 .3 1
	visible 1
	decoration
