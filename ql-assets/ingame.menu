	itemdef {
		name navbtn5
      		rect 452 108 94 25
      		background "ui/assets/score/btn.tga"
		style 1 
	      	visible 1 
		type 1
		cvarTest "ui_singleplayeractive"
		showCvar { "1" }
		action { open ingame_addbot
		 setitemcolor navbtn1o backcolor 1 1 1 0
		 setitemcolor navbtn2o backcolor 1 1 1 0
		 setitemcolor navbtn3o backcolor 1 1 1 0
		 setitemcolor navbtn4o backcolor 1 1 1 0
		 setitemcolor navbtn5o backcolor 1 1 1 1
		}
	      	backcolor 1 1 1 0.2
	}
	itemdef {
		name navbtn5o
      		rect 452 108 94 25
      		background "ui/assets/score/btno.tga"
		style 1 
	      	visible 1 
	      	decoration 
	      	backcolor 1 1 1 0
	}
	itemDef {
		name navbtn5t
		text "ADD BOT"
		textscale .18
		style 0	
		rect 459 108 80 20
      		textalignx 40      
      		textaligny 14 
		textalign 1		
		forecolor 1 1 1 1
		visible 1 
		decoration
		cvarTest "ui_singleplayeractive"
		showCvar { "1" }
	}

itemDef {
	name fullscreenbutton
	text "PLAY FULLSCREEN"
	type ITEM_TYPE_BUTTON
	textscale .18
	style WINDOW_STYLE_FILLED
	visible 1
	rect 464 31 134 13
	textalign 1
	textalignx 66
	textaligny 14
	//bordercolor 1 0 0 1
	//border 1
	forecolor 1 1 1 0.7
	cvarTest "r_fullscreen"
	hideCvar { "1" }
	//disableCvar { "1" }
	action { uiScript setFullScreen ; open ingame_about
		 setitemcolor navbtn1o backcolor 1 1 1 1
		 setitemcolor navbtn2o backcolor 1 1 1 0
		 setitemcolor navbtn3o backcolor 1 1 1 0
		 setitemcolor navbtn4o backcolor 1 1 1 0
		 setitemcolor navbtn5o backcolor 1 1 1 0
		}
	mouseEnter { setitemcolor fullscreenbutton forecolor 1 .75 0 1  }
	mouseExit { setitemcolor fullscreenbutton forecolor 1 1 1 0.7 }
	}
itemDef {
	name browserbutton
	text "PLAY IN BROWSER"
	type ITEM_TYPE_BUTTON
	textscale .18
	style WINDOW_STYLE_FILLED
	visible 1
	rect 464 45 134 13
	textalign 1
	textalignx 66
	textaligny 14
	forecolor 1 1 1 0.7
	backcolor .37 .1 .1 0
	//border 1
	//bordercolor 0 1 0 1
	cvarTest "r_fullscreen"
	hideCvar { "0" }
	//disableCvar { "0" }
	action { uiScript setWindowed ; open ingame_about
		 setitemcolor navbtn1o backcolor 1 1 1 1
		 setitemcolor navbtn2o backcolor 1 1 1 0
		 setitemcolor navbtn3o backcolor 1 1 1 0
		 setitemcolor navbtn4o backcolor 1 1 1 0
		 setitemcolor navbtn5o backcolor 1 1 1 0
		}
	mouseEnter { setitemcolor browserbutton forecolor 1 .75 0 1  }
  	mouseExit { setitemcolor browserbutton forecolor 1 1 1 0.7 }
	}
}

}

