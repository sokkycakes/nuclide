itemDef {
      	name gametypefield
	style 0
	text "Name:"	
 	ownerdraw UI_BOTNAME
      	rect 440 24 128 15
      	textalign 1		
      	textaligny 11   
	textscale .22
      	forecolor 1 1 1 1
      	border 0
      	bordercolor 0 0 0 0
