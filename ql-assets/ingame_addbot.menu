itemDef {
	name ok
	text "Add Bot"
	type 1
	textscale .24
	style WINDOW_STYLE_FILLED
	background "ui/assets/button_back.tga"
	rect 425 85 80 20
	textalign 1
	textalignx 40
	textaligny 15
	forecolor 1 1 1 1
	backcolor .37 .1 .1 1 
	visible 1
	action { uiScript addBot ; uiScript closeingame }
	mouseEnter { setitemcolor ok backcolor .1 .37 .1 1 }
      	mouseExit { setitemcolor ok backcolor .37 .1 .1 1 }
	}
	
