itemDef {
      	name quit
      	text "LEAVE MATCH"
      	textscale .2
      	textalign 0
      	style 0	
      	rect 62 274 48 30 
      	backcolor 0 0 0 0
      	forecolor 1 1 1 1
      	decoration
