// SETUP MENU \\

menuDef {
    	name "ingame_controls"
    	visible 0
    	fullscreen 0
    	rect -1 129 640 351
    	focusColor 1 .75 0 1
    	style 1
    	border 1
    	disableColor .5 .5 .5 1
	onClose {
	    uiScript saveControls
	}
	onopen { hide grpControls ; show move ; show header1 ; uiScript loadControls 
	 setitemcolor btn1t backcolor 0.2 0.2 0.2 1
	 setitemcolor btn1t forecolor 1 0.4 0.2 1
	 setitemcolor btn2t backcolor 0 0 0 0
	 setitemcolor btn2t forecolor 0.6 0.6 0.6 1
	 setitemcolor btn3t backcolor 0 0 0 0
	 setitemcolor btn3t forecolor 0.6 0.6 0.6 1
	 setitemcolor btn4t backcolor 0 0 0 0
	 setitemcolor btn4t forecolor 0.6 0.6 0.6 1
	}

