itemDef {
      	name quit
      	text "LEAVE MATCH"
      	textscale .2
      	textalign 0
      	style 0	
      	rect 62 274 48 30 
      	backcolor 0 0 0 0
      	forecolor 1 1 1 1
      	decoration
      	visible 1 	  
    	}
itemDef {
      	name ready
      	text "RETURN TO MATCH"
      	textscale .2
      	textalign 2
      	style 0	
      	rect 574 274 48 30 
      	backcolor 0 0 0 0
      	forecolor 1 1 1 1
      	decoration
      	visible 1 	  
    	}

itemDef {
      	name readyCLICK
      	style 0
      	rect 470 259 130 20 
      	backcolor 0 0 0 0
	//border 1
	//bordercolor .3 .3 .3 1
	type ITEM_TYPE_BUTTON
	      action { uiScript closeingame }
      	visible 1
		onFocus {
			transition ready 575 274 48 30 574 274 48 30 20 10
		}
    	}
itemDef {
      	name advertCLICK
      	style 0
      	rect 220 243 200 50
      	backcolor 0 0 0 0
      	type ITEM_TYPE_BUTTON
      	action { activateAdvert 1 }
      	visible 1
    	}
itemDef {
      	name quitCLICK
      	style 0
      	rect 38 259 100 20 
      	backcolor 0 0 0 0
	//border 1
	//bordercolor .3 .3 .3 1
	type ITEM_TYPE_BUTTON
	      	action { uiScript quit }
      	visible 1 
		onFocus {
			transition quit 63 274 48 30 62 274 48 30 20 10
		}
    	} 
}


