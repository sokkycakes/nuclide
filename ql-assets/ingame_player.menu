#include "ui/menudef.h"

{
\\ SETUP MENU \\

menuDef {
   	name "ingame_player"
   	visible 0
   	fullscreen 0
	outOfBoundsClick			// this closes the window if it gets a click out of the rectangle
   	rect 121 37 300 326
   	focusColor 1 .75 0 1
   	style 1
   	border 1
	onOpen  { uiScript update "ui_GetName" }
	onClose { uiScript update "ui_SetName" }


itemDef {
	name window
	rect 4 10 292 306
	style 1
	backcolor 0 0 0 0.8
	visible 1
	decoration
	}
itemDef {
	name window
	rect 5 39 290 200
	style 1
	backcolor 1 1 1 0.12
	background "ui/assets/menu/fade.tga"
	visible 1
	decoration
	}


