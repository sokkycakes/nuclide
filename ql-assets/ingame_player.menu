// BUTTON BACK IMAGES //

itemDef {
	name lit_player
	text "PLAYER"
	textscale .22
	style 3
	decoration
	background "ui/assets/menu/buttonlit.tga"
	rect 94 15 56 25
	textalign 1
	textalignx 28
	textaligny 18
	forecolor 1 1 1 1
	backcolor 1 1 1 1 
	visible 1
	decoration
	}

// 	BUTTONS	//
itemDef {
	name ctr_controls
	text "CONTROLS"
	textscale .22
	group grpbutton
	style WINDOW_STYLE_FILLED
	background "ui/assets/menu/button.tga"
	rect 38 15 56 25
	type 1
	textalign 1
	textalignx 28
	textaligny 18
	forecolor 1 1 1 1
	backcolor 1 1 1 1 
	visible 1
	action { open ingame_controls ; close ingame_player ; close ingame_options ; close ingame_system  }
	}
itemDef {
	name ctr_options
	text "OPTIONS"
	textscale .22
	group grpbutton
	style WINDOW_STYLE_FILLED
	background "ui/assets/menu/button.tga"
	rect 150 15 56 25
	type 1
	textalign 1
	textalignx 28
	textaligny 18
	forecolor 1 1 1 1
	backcolor 1 1 1 1 
	visible 1
	action { open ingame_options ; close ingame_controls ; close ingame_player ; close ingame_system  }
	}
itemDef {
	name ctr_system
	text "SYSTEM"
	textscale .22
	group grpbutton
	style WINDOW_STYLE_FILLED
	background "ui/assets/menu/button.tga"
	rect 206 15 56 25
	type 1
	textalign 1
	textalignx 28
	textaligny 18
	forecolor 1 1 1 1
	backcolor 1 1 1 1
	visible 1
	action { open ingame_system; close ingame_controls ; close ingame_player ; close ingame_options  }
	}


//PLAYER SETTINGS


itemDef {
   	name namefield
	group "playersettinggroup"
   	type ITEM_TYPE_EDITFIELD
	style 0
	text "Player Name:"
	cvar "ui_Name"
	maxchars 26
   	rect 0 70 290 20
   	textalign ITEM_ALIGN_RIGHT		
   	textalignx 148
   	textaligny 17
	textscale .25        
   	outlinecolor 1 .5 .5 .5
   	backcolor 0 0 0 0
   	forecolor 1 1 1 1
   	border 0
   	bordercolor 0 0 0 0
   	visible 1 
}
