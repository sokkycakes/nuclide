itemDef {
      	name handicapfield
	group "playersettinggroup"
      	style 0	
	text "Handicap:"
	ownerdraw UI_HANDICAP
	rect 20 45 256 20
      	textalign ITEM_ALIGN_LEFT		
      	textalignx 10
