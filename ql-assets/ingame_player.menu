	name navfill
	rect 5 14 290 27
	style 1
	visible 1
	decoration
	backcolor 0 0 0 1
	}
itemDef {
	name navfillinner
	rect 5 15 290 25
	style 1
	visible 1
	decoration
	backcolor 0.11 0.11 0.11 1
	}

itemDef {
