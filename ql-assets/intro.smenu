    	}
itemDef {
	name fullscreenbutton
	text "PLAY FULLSCREEN"
	type ITEM_TYPE_BUTTON
	textscale .18
	style WINDOW_STYLE_FILLED
	visible 1
	rect 464 31 134 13
	textalign 1
	textalignx 66
	textaligny 14
	//bordercolor 1 0 0 1
	//border 1
	forecolor 1 1 1 0.7
	cvarTest "r_fullscreen"
	hideCvar { "1" }
	//disableCvar { "1" }
	action { uiScript setFullScreen	}
	mouseEnter { setitemcolor fullscreenbutton forecolor 1 .75 0 1  }
	mouseExit { setitemcolor fullscreenbutton forecolor 1 1 1 0.7 }
	}
itemDef {
	name browserbutton
	text "PLAY IN BROWSER"
	type ITEM_TYPE_BUTTON
	textscale .18
	style WINDOW_STYLE_FILLED
	visible 1
	rect 464 45 134 13
	textalign 1
	textalignx 66
	textaligny 14
	forecolor 1 1 1 0.7
	backcolor .37 .1 .1 0
	//border 1
	//bordercolor 0 1 0 1
	cvarTest "r_fullscreen"
	hideCvar { "0" }
	//disableCvar { "0" }
	action { uiScript setWindowed }
	mouseEnter { setitemcolor browserbutton forecolor 1 .75 0 1  }
  	mouseExit { setitemcolor browserbutton forecolor 1 1 1 0.7 }
	}
}
