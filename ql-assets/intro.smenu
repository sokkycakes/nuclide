// if match is in warmup AND is CTF, show these buttons
	
	//BTN join red
	itemdef {
		name navBTNL
      		rect 485 206 80 20
      		background "ui/assets/score/navright.tga"
		style 3 
      		cvarTest "g_gametype"
      		hideCvar { "0","1","2" }
      		ownerdrawflag CG_SHOW_IF_WARMUP
  	    	type ITEM_TYPE_BUTTON
        	action { exec "team r" }
		onFocus {
			transition joinRed 540 220 48 30 539 220 48 30 20 10
		}
	}
	itemDef {
		name joinRed
		text "JOIN RED"
		textscale .2
		textalign 2
		style 0	
		rect 539 220 48 30 
		backcolor 0 0 0 0
		forecolor 1 1 1 1
		decoration
      		cvarTest "g_gametype"
      		hideCvar { "0","1","2" }
		ownerdrawflag CG_SHOW_IF_WARMUP
    	}
    	
