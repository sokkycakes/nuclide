    	}

itemDef {
      	name readyCLICK
      	style 0
      	rect 470 259 130 20 
      	backcolor 0 0 0 0
	//border 1
	//bordercolor .3 .3 .3 1
	type ITEM_TYPE_BUTTON
	      action { uiScript closeingame }
      	visible 1
		onFocus {
			transition ready 575 274 48 30 574 274 48 30 20 10
		}
    	}
itemDef {
      	name advertCLICK
