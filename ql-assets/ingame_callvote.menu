	}
	itemDef {
		name kick
		group grpCallVote
		rect 87 130 160 80
		style WINDOW_STYLE_FILLED
		type ITEM_TYPE_LISTBOX
		elementwidth 120
		elementheight 18
		textscale .18
		elementtype LISTBOX_TEXT
		feeder FEEDER_PLAYER_LIST
		border 1
		bordercolor .5 .5 .5 .5
		forecolor 1 1 1 1
		backcolor 0 0 0 .25
		outlinecolor .1 .1 .7 .5
		visible 1
		mouseEnter { setitemcolor kick bordercolor .7 0 0 1 } 
		mouseExit { setitemcolor kick bordercolor .5 .5 .5 1 }
		}
		itemDef {
			name basic
			text "   Call Vote"
			type 1
			textscale .2
			group grpCallVote
			style WINDOW_STYLE_FILLED
			background "ui/assets/button_back.tga"
			rect 252 195 58 15
			textalign 1
			textalignx 25
			textaligny 11
			forecolor 1 1 1 1
			backcolor .37 .1 .1 1 
			visible 1
			action { uiScript voteKick ; uiScript closeingame }
			mouseEnter { setcolor backcolor .5 .2 0 1 }
			mouseExit { setcolor backcolor .37 .1 .1 1 }	
			}

