#define PLAYER_RUN_AXE 0
#define PLAYER_RUN 1
#define PLAYER_IDLE 2
#define PLAYER_IDLE_AXE 3
#define PLAYER_PAIN_AXE 4
#define PLAYER_PAIN 5
#define PLAYER_DEATH_AXE1 6
#define PLAYER_DEATH1 7
#define PLAYER_DEATH2 8
#define PLAYER_DEATH3 9
#define PLAYER_DEATH4 10
#define PLAYER_DEATH5 11
#define PLAYER_ATTACK_NAILGUN 12
#define PLAYER_ATTACK_LIGHT 13
#define PLAYER_ATTACK_ROCKET 14
#define PLAYER_ATTACK_SHOTGUN 15
#define PLAYER_ATTACK_AXE1 16
#define PLAYER_ATTACK_AXE2 17
#define PLAYER_ATTACK_AXE3 18
#define PLAYER_ATTACK_AXE4 19

entityDef player
{
	"spawnclass"			"ncPlayer"
	"health"				"100"
	"maxarmor"				"100"
	"max_health"			"100"
	"bleeds"				"1"
	"propdata"				"actor_player"
	"armorProtection"		"0"
	"armorBonus"			"1"
	"ammo_shells"			"25"
	"weapon"				"weapon_collier_sidearm"
	"current_weapon"		"0"
	"pm_normalviewheight"	"64"
	"pm_walkspeed"			"280"
	"pm_runspeed"			"400"
	"pm_normalheight"		"72"
	"pm_crouchheight"		"36"
	"pm_crouchviewheight"	"28"
	"pm_boxcenter"			"1"
	"pm_runfiring"			"0"
	"model"					"models/player/alice2/alice2.mdl"
	// Skeletal backend: these CS/CSO models order the spine BEFORE the legs,
	// so the Valve single-basebone split would freeze the legs on the aim
	// pose. Skeletal builds the full gait, then overwrites only the torso
	// bone RANGE with the aim, and twists it in yaw via twistYaw.
	"animBackend"			"0"

	"spine"					"Bip01 Spine"
	"torsoStart"			"Bip01 Spine"
	// torsoEnd is the exclusive upper bound of the torso range; "Bip01 L Thigh"
	// is the first leg bone, so the torso covers Spine..Breast_Sub and the legs
	// keep the gait animation.
	"torsoEnd"				"Bip01 L Thigh"
	"twistYaw"				"Bip01 Spine"

	"snd_jump"				"Player.Jump"
	"snd_landSoft"			"Player.LandSoft"
	"snd_landHard"			"Player.LandHard"

	"act_idle"				"idle1"
	"act_jump"				"jump"
	"act_walk"				"walk"
	"act_run"				"run"
	"act_idle_crouch"		"crouch_idle"
	"act_walk_crouch"		"crouchrun"
	"act_pain"				"idle1"
	"act_death"				"death1,death2,death3"

	"act_aim"				"ref_aim_onehanded"
	"act_attack"			"ref_shoot_onehanded"
	"act_draw"				"ref_aim_onehanded"
	"act_reload"			"ref_reload_onehanded"

}

entityDef player_mp
{
	"inherit"			"player"
}


entityDef player_enforcer
{
	"inherit"		"player"
	"model"			"progs/enforcer.mdl"
	/* Quake vertex MDL has no HL skeleton; the skeletal backend can't build it. */
	"animBackend"	"1"
	
	"act_idle"		"$ENFORCER_IDLE"
	"act_walk"		"$ENFORCER_WALK"
	"act_run"		"$ENFORCER_RUN"
	"act_smallFlinch"	"$ENFORCER_PAIN1,$ENFORCER_PAIN2"
	"act_bigFlinch"		"$ENFORCER_PAIN3,$ENFORCER_PAIN4"
	"act_dieSimple"		"$ENFORCER_DEATH,$ENFORCER_FDEATH"
	"act_attack"		"$ENFORCER_ATTACK"

}
