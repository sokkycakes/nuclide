// Base melee weapon — TF2-style line+hull trace with optional cleave.
// Inheriting weapons must set "spawnclass" "ncWeaponBaseMelee".
//
// Deflect / cut support (opt-in via can_cut = 1):
//   When a melee swing hits an ncProjectile the projectile is destroyed,
//   a parry sound is played, and the weapon is locked for deflect_cooldown
//   seconds. Any melee weapon inheriting this base can enable it.
entityDef weapon_melee_base
{
	"spawnclass"			"ncWeaponBaseMelee"

	// ---- Melee-specific keys (TF2 CTFWeaponBaseMelee) ----
	"melee_range"			"64"
	"melee_bounds_mins"		"-18 -18 -18"
	"melee_bounds_maxs"		"18 18 18"
	"melee_cleave"			"0"
	"melee_damage"			"20"
	"melee_push"			"100"
	/* Seconds after swing start before DoSwingTrace runs (0 = immediate). */
	"melee_hit_delay"		"0"

	// ---- Deflect / cut (opt-in) ----
	"can_cut"				"0"
	"deflect_cooldown"		"1.75"
	"snd_cut"				""

	// ---- ncWeapon defaults for melee ----
	"ammoRequired"			"0"
	"silent_fire"			"1"
	// TF2 always swings; hit/miss is decided in DoSwingTrace (line+hull).
	// Negative testDistance required a LINE hit before the swing ran, which
	// made the hull-forgiveness path unreachable.
	"testDistance"			"0"
	"snd_swing"				"Melee_Swing"
	"fireRate"				"0.5"
	"failRate"				"0.5"

	/* CSO third-person slash (alice2-family). IQM heroes without these
	 * sequences simply skip the gesture. */
	"act_attack"			"ref_shoot_knife"
	"act_attack_crouch"		"crouch_shoot_knife"

	// ---- HUD ----
	"crosshair"				"none"
	"ammoIcon"				"none"
}

// Minimal damage decl for direct application.
// Weapons inheriting from weapon_melee_base can point to this if they
// still want a retro-compat projectile decl for fallback code paths.
entityDef melee_hit
{
	"spawnclass"		"ncProjectile"
	"is_bullet"			"1"
	"damage"			"skill:plr_axe"
	"range"				"64"
	"detonate_on_world"	"0"
}
