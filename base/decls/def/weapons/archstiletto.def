// Archstiletto primary: melee swing derived from the Quake axe (weapon_axe).
// Uses the v_archstiletto IQM viewmodel. NOTE: that model currently ships a
// single 8-frame sequence, so every viewmodel activity maps to sequence 0 until
// separate idle/fire/draw clips are authored. Placeholder tuning -- the boss kit
// is undesigned (see hero_archstiletto); to be deepened in a later pass.
entityDef weapon_archstiletto
{
	"inherit"			"weapon_axe"

	"editor_usage"		"Archstiletto melee (axe-derived) + lunge"

	"model_view"		"models/v_reference.iqm"
	"inv_name"			"Archstiletto"

	// melee override: boss kit hits hard, double range, cleave enabled
	"melee_damage"		"1"
	"melee_range"		"128"
	"melee_cleave"		"1"

	// sound
	"snd_swing"			"Melee_Swing"

	// v_archstiletto.iqm has one sequence (index 0); map all activities to it
	// until the model gains separate idle/fire/draw clips.
	"act_idle"			"0"
	"act_draw"			"0"
	"act_fireFailed"	"0"
	"act_fire"			"0"
}

entityDef projectile_archstiletto_melee
{
	"inherit"			"projectile_axe"
	"damage"			"1"
}
