// Vagrant knife — melee + throw projectile + warpknife.
//
// Controls:
//   M1 (INPUT_PRIMARY):   throw knife projectile (1 shot, 2s reload, arc physics)
//   Q  (INPUT_SECONDARY): melee swing (89u) + bullet cut + backstab
//   M2 (ability key):     throw warpknife / teleport / hold-to-pickup 1.5s
//   R:                    no function
//
// Backstab: Q from behind sets health=0 (bypasses HP/armor).
// Warpknife: sticky projectile, 1s–10s cooldown by distance, 1.5s wall cling
// on vertical teleports, 1.3s freeze on long-range (≥512u) teleports.
entityDef weapon_vagrant_knife
{
	"spawnclass"			"ncWeaponVagrantKnife"

	"editor_color"			".3 .3 1"
	"editor_mins"			"-16 -16 -16"
	"editor_maxs"			"16 16 16"
	"editor_usage"			"Vagrant knife (throw + melee + bullet cutter)"
	"editor_rotatable"		"1"

	// ---- Viewmodel ----
	"model_view"			"progs/v_axe.mdl"
	"animPrefix"			"axe"

	// ---- Primary fire: throw knife projectile ----
	"def_fireInfo"			"fireInfo_vagrant_throw"

	// ---- Clip / reload ----
	"ammoType"				"ammo_nails"
	"infiniteReserve"		"1"
	"ammoRequired"			"1"
	"ammoPerShot"			"1"
	"clipSize"				"1"
	"clipSizeDefault"		"1"
	"reloadTime"			"2.0"

	// ---- Melee swing (secondary fire) ----
	"melee_range"			"89"
	"melee_damage"			"1"
	"melee_push"			"50"
	"melee_cleave"			"0"
	"melee_bounds_mins"		"-18 -32 -18"
	"melee_bounds_maxs"		"18 32 18"

	// ---- Projectile cutting (secondary fire) ----
	"can_cut"				"1"
	"deflect_cooldown"		"1.75"
	"snd_cut"				"weapon_vagrant_knife.cut"

	// ---- Sounds ----
	"snd_acquire"			"weapon.pickup"
	"snd_respawn"			"item.respawn"
	"snd_swing"				"Melee_Swing"
	"snd_hit"				"Weapon_Axe.Melee_Hit"
	"snd_failed"			"Weapon_Axe.Miss"
	"snd_fire"				"weapon_vagrant_knife.throw"

	// ---- Weapon specific ----
	"testDistance"			"-89"
	"inv_name"				"Vagrant"
	"ammoRequired"			"0"
	"silent_fire"			"1"

	"fireRate"				"0.8"
	"failRate"				"0.8"
	"snd_hit"				"Weapon_Axe.Melee_Hit"
	"snd_failed"			"Weapon_Axe.Miss"

	"act_idle"				"0"
	"act_draw"				"0"
	"act_fireFailed"		"1,2"
	"act_fire"				"1,2"

	// ---- HUD ----
	"hudSlot"				"0"
	"hudSlotPos"			"0"
	"weight"				"0"
	"crosshair"				"none"
	"ammoIcon"				"none"
	"icon"					"weapon_axe.weapon"
	"iconSelected"			"weapon_axe.weapon_s"
}

// Fire info for the throw knife projectile.
entityDef fireInfo_vagrant_throw
{
	"def_onFire"			"projectile_vagrant_throwknife"
	"fireRate"				"0.6"
	"reloadTime"			"2.0"
	"semiAuto"				"1"
	"snd_fire"				"weapon_vagrant_knife.throw"
}

// Thrown knife projectile.
// 2x larger collision box than a base bullet, 25% slower velocity,
// gravity arc for weight feel, mid-range via fuse.
entityDef projectile_vagrant_throwknife
{
	"spawnclass"			"ncProjectile"
	"model"					"progs/spike.mdl"
	"mins"					"-4 -4 -4"
	"maxs"					"4 4 4"

	"velocity"				"1100"
	"gravity"				"0.8"
	"fuse"					"3.0"

	"detonate_on_world"		"1"
	"detonate_on_actor"		"1"

	"def_damage"			"damage_vagrant_throw"
	"damage"				"3"
	"snd_fly"				"weapon_vagrant_knife.flyloop"
	"snd_hitActor"			"weapon_vagrant_knife.throwhit"
	"snd_explode"			"weapon_vagrant_knife.wallhit"

	"modelscale"			"5"
}

entityDef damage_vagrant_throw
{
	"damage"	"3"
}

// Warpknife: variant of the throw knife that sticks to surfaces instead of
// detonating. Tracked by the weapon — one active on the field at a time.
// Despawns on player damage; pickup via reload while within 32 units.
entityDef projectile_vagrant_warpknife
{
	"inherit"				"projectile_vagrant_throwknife"

	"detonate_on_world"		"0"
	"detonate_on_actor"		"0"
	"stick_to_world"		"1"
	"fuse"					"0"
}

// Fire info for the warpknife throw (swapped in when m_bWarpQueued).
entityDef fireInfo_vagrant_warp
{
	"def_onFire"			"projectile_vagrant_warpknife"
	"fireRate"				"0.6"
	"reloadTime"			"2.0"
	"semiAuto"				"1"
	"snd_fire"				"weapon_vagrant_knife.throw"
}
