#crosshair-star {
	position: absolute;
	left: 44.041%;
	top: 37.465%;
	width: 11.918%;
	height: 12.597%;
	opacity: 0.9;
}

#speedometer {
	position: absolute;
	left: 12%;
	top: 80%;
	width: 10%;
	height: 8%;
	display: flex;
	align-items: center;
	justify-content: center;
}

.speedometer-art {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	opacity: 0.85;
	pointer-events: none;
	z-index: 0;
}

.speed-value {
	position: relative;
	font-size: 22dp;
	line-height: 28dp;
	font-weight: 600;
	color: #d9e0e6;
