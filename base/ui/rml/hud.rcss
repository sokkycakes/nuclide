/*
 * Stiletto HUD — layout from base/stilettohudsvg.txt (viewBox 0 0 1440 1080, 4:3).
 * #hud-root is a fixed 4:3 surface (largest 4:3 rect inside the window); percentages
 * are relative to that surface so layout does not stretch on wide/tall windows.
 * #hurt-overlay stays on <body> and still covers the full viewport.
 */

body {
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	margin: 0;
	padding: 0;
	box-sizing: border-box;
	background-color: transparent;
	font-family: Arial;
	color: #f2f2f2;
	pointer-events: none;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
}

#hud-root {
	position: relative;
	box-sizing: border-box;
	flex-shrink: 0;
	flex-grow: 0;
}

@media (min-aspect-ratio: 4/3) {
	#hud-root {
		width: 133.333vh;
		height: 100vh;
		max-width: 100vw;
	}
}

@media (max-aspect-ratio: 4/3) {
	#hud-root {
		width: 100vw;
		height: 75vw;
		max-height: 100vh;
	}
}

.hurt-overlay {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	width: auto;
	height: auto;
	box-sizing: border-box;
	opacity: 0;
	pointer-events: none;
	z-index: 100;
}

#hud-root img {
	display: block;
	box-sizing: border-box;
}

.ref-line {
	position: absolute;
	left: 1.39%;
	top: 1.11%;
	width: 40%;
	height: 1.2%;
	margin: 0;
	padding: 0;
	font-size: 11dp;
	line-height: 13dp;
	font-weight: 400;
	color: #bfc7d1;
	visibility: hidden;
}

/* Region overlays — layout guides; keep invisible in-game */
.hud-region {
	position: absolute;
	box-sizing: border-box;
	background-color: rgba(0, 0, 0, 0.12);
	opacity: 0;
	visibility: hidden;
}

#region-tl {
	left: 0;
	top: 0;
	width: 27.708%;
	height: 25.833%;
}

#region-tr {
	left: 72.257%;
	top: 0;
	width: 27.708%;
	height: 25.833%;
}

#region-bl {
	left: 0;
	top: 74.12%;
	width: 33.264%;
	height: 25.833%;
}

#region-br {
	left: 66.701%;
	top: 74.12%;
	width: 33.264%;
	height: 25.833%;
}

/* Arena match-state block (U7). Top-center of the 4:3 HUD safe surface so it
   does not stretch on widescreen. Hidden by default; an engine-side binding
   (see hud.rml note) reveals it and pushes the arena_* serverinfo strings into
   the #arena_state / #arena_round / #arena_ready / #arena_p1 / #arena_p2 ids. */
#arena-matchstate {
	position: absolute;
	left: 30%;
	top: 1.5%;
	width: 40%;
	box-sizing: border-box;
	display: none;
	flex-direction: column;
	align-items: center;
	gap: 2dp;
	pointer-events: none;
	z-index: 50;
}

.arena-state-label {
	font-size: 24dp;
	line-height: 28dp;
	font-weight: 700;
	color: #f2f2f2;
	letter-spacing: 2dp;
}

.arena-round-line {
	font-size: 15dp;
	line-height: 18dp;
	font-weight: 600;
	color: #bfc7d1;
}

.arena-ready-line {
	font-size: 13dp;
	line-height: 16dp;
	font-weight: 400;
	color: #bfc7d1;
}

.arena-competitors {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8dp;
	font-size: 15dp;
	line-height: 18dp;
	font-weight: 600;
	color: #f2f2f2;
}

.arena-vs {
	font-size: 12dp;
	font-weight: 400;
	color: #8893a0;
}

/* Full-viewport deco: ring under bcenter; both under #cluster-center in DOM paint order */
#deco-wrap {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	pointer-events: none;
	z-index: 0;
}

#deco-ring-outer {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	margin: 0;
	opacity: 1;
}

/* bcenter: Godot 1137.5×1137.5 centered on full 1440×1080 (not inside the 400×360 cluster) */
#deco-bcenter.deco-bcenter-img {
	position: absolute;
	left: 10.486%;
	top: -2.662%;
	width: 79.028%;
	height: 105.324%;
	margin: 0;
	opacity: 0.35;
	pointer-events: none;
	z-index: 1;
}

/* infopanel: Godot 700×84 @ bottom 194px, left −8px (1440 ref); art 649×423 — clip, do not stretch.
   SVG pivot for rotate(-30) is rect top-left (-488,1152) → transform-origin 0 0 (not bottom-left). */
#infopanelleft {
	box-sizing: border-box;
	position: absolute;
	width: 48.611%;
	height: 7.778%;
	left: -34%;
	bottom: 17.963%;
	background-color: rgba(0, 0, 0, 0.92);
	border-width: 0;
	border-style: none;
	border-radius: 56dp;
	transform: rotate(-30deg);
	transform-origin: 0% 0%;
	overflow: hidden;
}

.infopanel-art {
	position: absolute;
	left: 0;
	right: 0;
	top: 50%;
	width: 100%;
	height: auto;
	margin: 0 auto;
	transform: translateY(-50%);
	opacity: 1;
	pointer-events: none;
	z-index: 0;
}

#panel-control2 {
	box-sizing: border-box;
	position: absolute;
	width: 91.13%;
	height: 81.15%;
	left: 7.43%;
	bottom: 5.75%;
	background-color: rgba(0, 0, 0, 0.35);
	border-width: 2dp;
	border-color: rgba(255, 255, 255, 0.35);
	border-style: solid;
	border-radius: 50dp;
	display: flex;
	align-items: center;
	justify-content: center;
	z-index: 1;
}

.infopanel-value {
	font-size: 28dp;
	font-weight: 600;
	color: #f2f2f2;
}

#kill-counter {
	box-sizing: border-box;
	position: absolute;
	left: 0;
	top: 76.944%;
	width: 8.71%;
	height: 9.805%;
	padding: 4dp 0 0 8dp;
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: flex-end;
	gap: 2dp;
	background-color: rgba(0, 0, 0, 0.45);
	border-width: 0;
	border-style: none;
	transform: rotate(-30deg);
	transform-origin: -3.99% 56.66%;
}

.kill-label {
	font-size: 13dp;
	line-height: 16dp;
	font-weight: 400;
	color: #bfc7d1;
}

.kill-value {
	font-size: 26dp;
	line-height: 31dp;
	font-weight: 600;
	color: #f2f2f2;
}

#cluster-center {
	position: absolute;
	left: 36.146%;
	top: 35.231%;
	width: 27.708%;
	height: 33.241%;
	box-sizing: border-box;
}

.sprite-quickinfo {
	position: absolute;
	left: 36.466%;
	top: 36.602%;
	width: 27.068%;
	height: 26.741%;
	opacity: 0.95;
	z-index: 1;
}

.ammopip-img {
	position: absolute;
	width: 5.013%;
	height: 5.572%;
	transform: rotate(8.54deg);
	transform-origin: 0 0;
}

.abilitypip-img {
	position: absolute;
	width: 5.013%;
	height: 5.572%;
}

#ammopip1 {
	left: 54.997%;
	top: 56.196%;
}

#ammopip2 {
	left: 58.864%;
	top: 53.717%;
}

#ammopip3 {
	left: 55.369%;
	top: 51.494%;
}

#ammopip4 {
	left: 59.010%;
	top: 48.707%;
}

#ammopip5 {
	left: 62.892%;
	top: 46.240%;
}

#ammopip6 {
	left: 59.398%;
	top: 43.980%;
}

#abilitypip1 {
	left: 36.466%;
	top: 42.202%;
}

#abilitypip2 {
	left: 36.718%;
	top: 47.772%;
}

#abilitypip3 {
	left: 40.200%;
	top: 51.950%;
}

.weapon-icon {
	position: absolute;
	left: 45.490%;
	top: 56.964%;
	width: 9.023%;
	height: 10.028%;
	opacity: 0.95;
}

#reloadTimer {
	position: absolute;
	left: 64.207%;
	top: 55.070%;
	width: 8.020%;
	height: 6.130%;
	display: flex;
	align-items: center;
	justify-content: center;
}

.reloadTimer-art {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	opacity: 0.9;
	pointer-events: none;
	z-index: 0;
}

.reload-value {
	position: relative;
	font-size: 16dp;
	line-height: 19dp;
	font-weight: 400;
	color: #e6e6eb;
	z-index: 1;
}

#heart-cluster {
	position: absolute;
	left: 37.193%;
	top: 56.964%;
	width: 7.268%;
	height: 7.242%;
	display: flex;
	align-items: center;
	justify-content: center;
}

#heart-frame {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	opacity: 0.95;
	pointer-events: none;
	z-index: 0;
}

.heart-value {
	position: relative;
	width: 90%;
	height: auto;
	margin: 0;
	font-size: 15dp;
	font-weight: 600;
	color: #f2f2f2;
	text-align: center;
	line-height: 1.1;
	z-index: 1;
