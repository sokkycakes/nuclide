/* BasemodUI stylesheet - Alien Swarm Foundation wireframe port
   Adapted from web/basemod-wireframes-foundation/css/wireframe.css
   Low-fidelity layout placeholders with semantic structure
*/

/* CSS Variables (RmlUi uses decorator properties instead) */
body {
	margin: 0;
	padding: 0;
	font-family: LatoLatin;
	font-size: 13px;
	background-color: #1a1a1a;
	color: #e0e0e0;
	width: 100%;
	height: 100%;
}

/* Root app container */
#app {
	position: relative;
	width: 100%;
	height: 100%;
	padding-bottom: 36px; /* footer height */
}

/* Utility classes */
.hidden {
	display: none;
}

/* Footer panel (CBaseModFooterPanel) */
.footer-panel {
	position: fixed;
	bottom: 0;
	left: 0;
	right: 0;
	height: 36px;
	background-color: #111;
	border-top-width: 2px;
	border-top-color: #666;
	display: flex;
	align-items: center;
	gap: 24px;
	padding: 0 16px;
	z-index: 100;
}

.footer-panel span {
	font-size: 11px;
	color: #e0e0e0;
}

/* Panel views - full screen containers */
.panel.view {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 36px; /* above footer */
	display: none; /* hidden by default */
	flex-direction: column;
	background-color: #2a2a2a;
	border-width: 2px;
	border-color: #666;
}

.panel.view.active {
	display: flex; /* show active view */
}

/* Garnish headers/footers */
.garnish-top,
.garnish-bottom {
	flex-shrink: 0;
	height: 28px;
	background-color: #3a3a3a;
	border-width: 1px;
	border-color: #666;
	display: flex;
	align-items: center;
	padding: 0 12px;
}

.garnish-label {
	font-weight: bold;
	letter-spacing: 0.08em;
	text-transform: uppercase;
	color: #e0e0e0;
}

.garnish-minor {
	margin-left: auto;
	color: #888;
	font-size: 11px;
}

/* Panel body - scrollable content area */
.panel-body {
	flex: 1;
	overflow: auto;
	padding: 16px;
}

/* Main menu layout - two column grid */
.mainmenu-layout {
	display: flex;
	gap: 24px;
	height: 100%;
}

.mainmenu-layout .nav-column {
	width: 280px;
	flex-shrink: 0;
}

.mainmenu-layout .quickjoin-block {
	flex: 1;
}

/* Navigation column - vertical button stack */
.nav-column {
	display: flex;
	flex-direction: column;
	gap: 6px;
}

/* Hybrid buttons - main interactive elements */
.hybrid-btn {
	display: block;
	width: 100%;
	text-align: left;
	padding: 10px 14px;
	background-color: #3a3a3a;
	border-width: 1px;
	border-color: #666;
	color: #e0e0e0;
	cursor: pointer;
	font-family: LatoLatin;
	font-size: 13px;
}

.hybrid-btn:hover {
	border-color: #44aa99;
}

.hybrid-btn.active {
	border-color: #44aa99;
	background-color: #2d4a3a;
}

.hybrid-btn.primary {
	border-color: #44aa99;
	border-width: 2px;
}

/* Text buttons - secondary actions */
.text-btn {
	background-color: transparent;
	border-width: 1px;
	border-color: #888;
	color: #888;
	padding: 4px 8px;
	cursor: pointer;
	font-family: LatoLatin;
	font-size: 13px;
}

/* Quick join and chat blocks */
.quickjoin-block,
.chat-block {
	border-width: 1px;
	border-color: #666;
	padding: 12px;
	min-height: 120px;
}

.block-title {
	font-size: 10px;
	color: #888;
	margin-bottom: 8px;
	text-transform: uppercase;
}

.placeholder-list .list-item,
.player-slot {
	border-width: 1px;
	border-color: #555;
	padding: 8px;
	margin-bottom: 4px;
	font-size: 11px;
}

/* Flyout menus - overlay panels */
.flyout {
	position: absolute;
	top: 28px; /* below garnish */
	right: 16px;
	width: 240px;
	background-color: #333;
	border-width: 2px;
	border-color: #44aa99;
	padding: 12px;
	z-index: 50;
	display: flex;
	flex-direction: column;
	gap: 6px;
}

.flyout-title {
	font-size: 10px;
	color: #888;
	margin-bottom: 4px;
}

/* Settings layout - two column grid */
.settings-layout {
	display: flex;
	gap: 24px;
	height: 100%;
}

.settings-left,
.settings-right {
	flex: 1;
}

/* Dropdown rows */
.dropdown-row {
	display: flex;
	align-items: center;
	gap: 12px;
	margin-bottom: 10px;
	padding: 6px;
	border-width: 1px;
	border-color: #555;
}

.dropdown-row label {
	min-width: 140px;
	font-size: 11px;
	color: #888;
}

.dropdown-row select {
	flex: 1;
	background-color: #222;
	color: #e0e0e0;
	border-width: 1px;
	border-color: #666;
	padding: 4px;
	font-family: LatoLatin;
	font-size: 13px;
}

/* Poster/image placeholders */
.poster {
	border-width: 2px;
	border-color: #666;
	min-height: 100px;
	display: flex;
	align-items: center;
	justify-content: center;
	color: #888;
	margin-bottom: 12px;
}

.poster.large {
	min-height: 200px;
}

/* Action row - bottom button bar */
.action-row {
	padding: 12px 16px;
	border-top-width: 1px;
	border-top-color: #666;
	display: flex;
	gap: 12px;
	flex-shrink: 0;
}

/* Lobby layout - two column grid */
.lobby-layout {
	display: flex;
	gap: 20px;
	height: 100%;
}

.lobby-left {
	width: 320px;
	flex-shrink: 0;
}

.lobby-right {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: 12px;
}

/* Player list */
.player-list {
	flex: 1;
	border-width: 1px;
	border-color: #666;
	padding: 8px;
	min-height: 160px;
}

.player-slot.focused {
	border-color: #44aa99;
	background-color: #2a3a2a;
}

.player-slot .slot-name {
	font-weight: bold;
}

.player-slot .slot-meta {
	font-size: 10px;
	color: #888;
}

/* Chat log */
.chat-log {
	height: 80px;
	overflow-y: auto;
	font-size: 11px;
	color: #888;
	margin-bottom: 6px;
}

.chat-log .msg {
	margin-bottom: 2px;
}

/* Loading layout - centered content */
.loading-layout {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 20px;
	height: 100%;
}

.progress-block {
	width: 400px;
}

.progress-bar {
	width: 100%;
	height: 16px;
	border-width: 1px;
	border-color: #666;
	background-color: #111;
	position: relative;
}

.progress-fill {
	height: 100%;
	width: 0%;
	background-color: #44aa99;
	position: absolute;
	top: 0;
	left: 0;
}

.footer-caption {
	font-size: 11px;
	color: #888;
	text-align: center;
}

/* In-game menu layout */
.ingame-layout {
	display: flex;
	justify-content: center;
	align-items: flex-start;
	padding-top: 40px;
}

.ingame-layout .nav-column {
	max-width: 400px;
}

/* Vote layout */
.vote-layout {
	display: flex;
	flex-direction: column;
	gap: 6px;
	max-width: 400px;
	margin: 0 auto;
}

/* List select buttons */
.list-select {
	text-align: left;
	padding: 12px;
	background-color: #3a3a3a;
	border-width: 1px;
	border-color: #666;
	color: #e0e0e0;
	cursor: pointer;
	font-family: LatoLatin;
	font-size: 13px;
}

.list-select:hover {
	border-color: #44aa99;
}

/* Overlay - modal background */
.overlay {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 36px; /* above footer */
	background-color: rgba(0, 0, 0, 0.75);
	display: flex;
	align-items: center;
	justify-content: center;
	z-index: 200;
}

/* Confirmation dialog */
.confirm-dialog {
	background-color: #2a2a2a;
	border-width: 2px;
	border-color: #44aa99;
	padding: 24px;
	min-width: 360px;
	max-width: 480px;
}

.confirm-title {
	font-weight: bold;
	margin-bottom: 12px;
	text-transform: uppercase;
	color: #e0e0e0;
}

.confirm-message {
	color: #888;
	margin-bottom: 20px;
	line-height: 1.5;
}

.confirm-actions {
	display: flex;
	gap: 12px;
}

/* Summary lines */
.summary-lines {
	margin-bottom: 12px;
}

.summary-line {
	font-size: 11px;
	padding: 4px 0;
	border-bottom-width: 1px;
	border-bottom-color: #444;
}

/* Label blocks */
.label-block {
	font-size: 11px;
	color: #888;
	padding: 4px;
}

/* Input fields */
input[type="text"] {
	width: 100%;
	background-color: #222;
	color: #e0e0e0;
	border-width: 1px;
	border-color: #666;
	padding: 6px;
	font-family: LatoLatin;
	font-size: 13px;
}
