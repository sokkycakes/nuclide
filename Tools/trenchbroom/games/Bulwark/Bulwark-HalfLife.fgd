@SolidClass base(NuclideIO, BrushCompile, BulwarkScripted) color(0 128 204) = func_tracktrain : "An interactive train that moves along a series of path_track entities. It turns and can respond to user input. It does not necessarily have to. Notes: Upon level entry, the func_tracktrain will spawn right where its first path_track node is, as specified in `target`. This is so you can light the func_tracktrain somewhere else - like a lonely box somewhere outside the playable area. If no targetname is specified, the train will move on its own at map-launch. By default, any func_tracktrain can be interacted with by players. You can restrict the area in which the train can be used with a func_traincontrols entity. You can also set the NOUSER (2) spawnflag to disable it entirely."
[
	targetname(target_source) : "Targetname" : "" : "Name"
	target(target_destination) : "Target" : "" : "First node to target."
	killtarget(target_destination) : "Killtarget" : "" : "Target to kill when triggered."
	dmg(string) : "Dmg" : "" : "Damage to inflict upon a person blocking the way."
	snd_move(string) : "Snd move" : "" : "Path to sound sample which plays when it's moving."
	snd_stop(string) : "Snd stop" : "" : "Path to sound sample which plays when it stops moving."
	spawnflags(flags) =
	[
		1 : "NOPITCH" : 0 : "Stop at each path_track until we're triggered again."
		2 : "NOUSER" : 0 : "Train does not pivot up/down at all."
		4 : "NOTSOLID" : 0 : "NOTSOLID"
		8 : "NOTSOLID" : 0 : "Don't do collision testing against this entity."
		16 : "FIXED" : 0 : "Fixed orientation. Will not turn, only move."
	]
]

@SolidClass base(NuclideIO, BrushCompile, BulwarkScripted) color(0 128 204) = func_train : "Moving platform following along path_corner entities, aka nodes. Most of its behaviour is controlled by the path_corner entities it passes over. See the entity definition for path_corner to find out more. Notes: Upon level entry, the func_train will spawn right where its first path_corner node is. This is so you can light the func_train somewhere else - like a lonely box somewhere outside the playable area. If no targetname is specified, the train will move on its own at map-launch. Marking the func_train with the spawnflag NOT_SOLID will make entities not collide with the train. This is best used for things in the distance or for when lasers are following this train as a sort of guide."
[
	targetname(target_source) : "Targetname" : "" : "Name"
	target(target_destination) : "Target" : "" : "First node."
	killtarget(target_destination) : "Killtarget" : "" : "Target to kill when triggered."
	dmg(string) : "Dmg" : "" : "Damage to inflict upon a person blocking the way."
	snd_move(string) : "Snd move" : "" : "Path to sound sample which plays when it's moving."
	snd_stop(string) : "Snd stop" : "" : "Path to sound sample which plays when it stops moving."
	spawnflags(flags) =
	[
		1 : "WAIT" : 0 : "Stop at each path_corner until we're triggered again."
		8 : "NOT_SOLID" : 0 : "Don't do collision testing against this entity."
	]
]

