	[
		0 : "No"
		1 : "Yes"
	]
	spawnflags(flags) =
	[
		1 : "TF_CLIENTS" : 0 : "Clients can touch it. Legacy TM_MONSTERS: Allow NPCs to activate this entity."
		2 : "TF_NPCS" : 0 : "NPCs can touch it. Legacy TM_NOCLIENTS: Don't allow players to activate this entity."
		4 : "TF_PUSHABLE" : 0 : "Pushables can touch it. Legacy TM_PUSHABLES: Allow func_pushables to trigger this entity."
		8 : "TF_PHYSICS" : 0 : "ncPhysicsEntity based classes can touch it."
		16 : "TF_FRIENDLIES" : 0 : "Friendly NPCs can touch it."
		32 : "TF_CLIENTSINVEHICLES" : 0 : "Clients within vehicles can touch it."
		64 : "TF_EVERYTHING" : 0 : "Everything can touch it."
		512 : "TF_CLIENTSNOTINVEHICLES" : 0 : "Clients outside vehicles can touch it."
		1024 : "TF_DEBRIS" : 0 : "Debris can touch it."
		2048 : "TF_NPCSINVEHICLES" : 0 : "NPCs in vehicles can touch it."
		4096 : "TF_NOBOTS" : 0 : "Bots are never allowed to touch it."
	]
	input Enable(void) : "Enable the entity."
	input Disable(void) : "Disable the entity."
	input Toggle(void) : "Toggles between enabled/disabled states."
	output OnStartTouch(void) : "Triggered when something starts touching this volume"
	output OnEndTouchAll(void) : "Triggered when nothing touched the entity no more"
]

