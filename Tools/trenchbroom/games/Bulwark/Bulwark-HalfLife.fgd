	lip(string) : "Lip" : "" : "How many units remain visible when fully pushed in."
	snd_pressed(string) : "Snd pressed" : "" : "The sound shader name to play when pressed down."
	snd_unpressed(string) : "Snd unpressed" : "" : "The sound shader name to play when the button becomes raised."
	wait(string) : "Wait" : "" : "Time to wait in seconds before the button becomes raised."
	delay(string) : "Delay" : "" : "Delay until the Target gets triggered."
	sounds(string) : "Sounds" : "" : "Obsolete legacy key for HL/Q1 style buttons to decide which sounds to play."
	health(string) : "Health" : "" : "Amount of damage this button takes before it triggers. Will reset."
	spawnflags(flags) =
	[
		1 : "SF_BTT_NOMOVE" : 0 : "Don't move when it's activated."
		32 : "SF_BTT_TOGGLE" : 0 : "Don't move back to the raised state automatically."
		64 : "SF_BTT_SPARKS" : 0 : "Spawn decorative sparks when used."
		256 : "SF_BTT_TOUCH_ONLY" : 0 : "Disable 'use' key/button. Only collision will activate it."
	]
	output OnDamaged(void) : "Fired when the button is damaged."
	output OnPressed(void) : "Fired when the button is pressed."
	output OnUseLocked(void) : "Fired when the button is used while locked."
