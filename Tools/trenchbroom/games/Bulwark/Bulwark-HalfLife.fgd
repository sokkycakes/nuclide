@PointClass base(NuclideIO, BulwarkScripted) color(0 204 204) size(-16 -16 0, 16 16 72) = ncTalkMonster : "This class represents ncMonsters that talk. They need to network extra information and can speak more complicated dialogue using the [Sentences](@ref sentences) system. They also can communicate with other ncTalkMonster based entities."
[
	targetname(target_source) : "Targetname" : "" : "Name"
	netname(string) : "Netname" : "" : "Name used for obituaries and debug info."
	maxs(string) : "Maxs" : "" : "Bounding box mins."
	mins(string) : "Mins" : "" : "Bounding box maxs. ## KEYS - SENTENCES"
	talk_answer(string) : "Talk answer" : "" : "SentenceDef to play when they're providing a generic answer to a question."
	talk_ask(string) : "Talk ask" : "" : "SentenceDef to play when they're asking a question."
	talk_ally_shot(string) : "Talk ally shot" : "" : "SentenceDef to play when they're commenting on an ally being shot."
	talk_greet(string) : "Talk greet" : "" : "SentenceDef to play when greeting an ally."
	talk_idle(string) : "Talk idle" : "" : "SentenceDef to play when idling about."
	talk_panic(string) : "Talk panic" : "" : "SentenceDef to play when the state from being calm changes to being fearful."
	talk_hearing(string) : "Talk hearing" : "" : "SentenceDef to play when commenting on a suspicious noise."
	talk_smelling(string) : "Talk smelling" : "" : "SentenceDef to play when commenting on a suspicious smell."
	talk_stare(string) : "Talk stare" : "" : "SentenceDef to play when commenting on the player staring at them."
	talk_survived(string) : "Talk survived" : "" : "SentenceDef to play when they've survived an attack."
	talk_wounded(string) : "Talk wounded" : "" : "SentenceDef to play when they've been severely wounded."
	talk_alert(string) : "Talk alert" : "" : "SentenceDef to play when they've become alerted."
	talk_player_ask(string) : "Talk player ask" : "" : "SentenceDef to play when they want to ask the player a question."
	talk_player_greet(string) : "Talk player greet" : "" : "SentenceDef to play when they want to greet the player."
	talk_player_idle(string) : "Talk player idle" : "" : "SentenceDef to play when they hang around the player."
	talk_player_wounded1(string) : "Talk player wounded1" : "" : ""
	talk_player_wounded2(string) : "Talk player wounded2" : "" : ""
	talk_player_wounded3(string) : "Talk player wounded3" : "" : ""
	talk_unfollow(string) : "Talk unfollow" : "" : "SentenceDef to play for when they're choosing to unfollow someone."
	talk_follow(string) : "Talk follow" : "" : "SentenceDef to play for when they're choosing follow someone."
	talk_stop_follow(string) : "Talk stop follow" : "" : "SentenceDef to play for when they're being asked to unfollow someone."
	talk_deny_follow(string) : "Talk deny follow" : "" : "SentenceDef to play for when they're denying the follow request."
	follow_on_use(string) : "Follow on use" : "" : "Can be either 0 or 1, will decide if they can follow someone."
	follow_dist(string) : "Follow dist" : "" : "Distance between the it and the player its following."
	follow_maxdist(string) : "Follow maxdist" : "" : "Maximum distance between it and the player before giving up following them. For more keys, see ncMonster."
	spawnflags(flags) =
	[
		1 : "WAITTILLSEEN" : 0 : "WAITTILLSEEN"
		2 : "GAG" : 0 : "GAG"
		4 : "MONSTERCLIP" : 0 : "MONSTERCLIP"
		16 : "PRISONER" : 0 : "PRISONER"
		64 : "IGNOREPLAYER" : 0 : "IGNOREPLAYER"
		128 : "WAITFORSCRIPT" : 0 : "WAITFORSCRIPT"
		256 : "PREDISASTER" : 0 : "PREDISASTER"
		512 : "FADECORPSE" : 0 : "FADECORPSE"
		1024 : "MULTIPLAYER" : 0 : "MULTIPLAYER"
		2048 : "FALLING" : 0 : "FALLING"
		4096 : "HORDE" : 0 : "HORDE"
	]
]

@PointClass base(NuclideIO, BulwarkScripted) color(0 204 204) size(-16 -16 0, 16 16 32) = ncWeapon : "This entity class represents weapon based items. It is based on ncItem. The only difference is that the attack related keys get forwarded only to items of this class. This is not a class that you can instantiate using level entity data due to its complexity, you will almost exclusively enter the data using [entityDef](@ref entitydef) instead. ## FireInfo Weapon firing events are split into optional decl titled 'FireInfo' that are queried for implemented attack types. The 'def_fireInfo' key points to the decl containing the primary-attack FireInfo. If that doesn't exist, the keys that would be queried from there are read from the main decl. This goes for any key that is not present in a FireInfo. The 'def_altFireInfo' key points to the decl containing the secondary-attack FireInfo. If that does not exist, secondary attacks are not possible."
[
	model(string) : "Model" : "" : "Item/pickup model in world."
	model_view(string) : "Model view" : "" : "First-person view model."
	model_viewMirror(choices) : "Model view Mirror" : 0 : "Set to 1 to mirror the view model left to right (left-handed models, e.g. CSO)." =
	[
		0 : "No"
		1 : "Yes"
	]
	model_flash(string) : "Model flash" : "" : "muzzleflash model/sprite to use."
	flashColor(string) : "Flash Color" : "" : "muzzleflash dlight color"
	flashRadius(string) : "Flash Radius" : "" : "muzzleflash dlight radius"
	def_dropItem(string) : "Def drop Item" : "" : "when this item is dropped from someones inventory, will spawn this entityDef item instead."
	snd_acquire(string) : "Snd acquire" : "" : "pickup noise"
	snd_respawn(string) : "Snd respawn" : "" : "respawn noise"
	snd_hum(string) : "Snd hum" : "" : "idle shader"
	smoke_muzzle(string) : "Smoke muzzle" : "" : "smoke particle effect name"
	continuousSmoke(string) : "Continuous Smoke" : "" : "whether the particle effect is continous"
	clipSize(string) : "Clip Size" : "" : "maximum clip size"
	clipSizeDefault(string) : "Clip Size Default" : "" : "Initial clip size on pickup."
	speed_mod(string) : "Speed mod" : "" : "Multiplier on the holder's movement speed."
	speed_mod_firing(string) : "Speed mod firing" : "" : "When set, replaces 'speed_mod' while the weapon is being fired or charged (like a spun-up minigun)."
	speed_mod_zoomed(string) : "Speed mod zoomed" : "" : "When set, replaces 'speed_mod' while the holder is zoomed in."
	animPrefix(string) : "Anim Prefix" : "" : "Alternative set of animations to use by the weapon. See the ncPlayer documentation for details about the set of activities that will be picked from. ## FireInfo related keys"
	def_onFire(string) : "Def on Fire" : "" : "Def to spawn when the weapon is fired."
	def_onRelease(string) : "Def on Release" : "" : "Def to spawn when the weapon has been released."
	fireUnderwater(string) : "Fire Underwater" : "1" : "Default is 1, will set if the weapon can be fired underwater. ### Ammo management related keys"
	ammoType(string) : "Ammo Type" : "" : "name of the ammo type def entry which the weapon uses"
	ammoRequired(string) : "Ammo Required" : "" : "set to 1 if we require ammo."
	ammoPerShot(string) : "Ammo Per Shot" : "" : "Amount of ammo to deduct per successful shot. ### Charging/Overcharging For an overcharge effect, spawn a self-destructive explosion on 'def_onFire', and rely on 'def_onRelease' for delivering a lethal charge to other enemies."
	chargeTime(string) : "Charge Time" : "" : "Amount of time the weapon has to charge before 'def_onFire' is spawned. ### Overheating weapons Overheating of the weapon is done when both keys are set."
	overheatLength(string) : "Overheat Length" : "" : "Time in which it takes for the weapon to cool down."
	overheatPerShot(string) : "Overheat Per Shot" : "" : "Time added against 'overheatLength' when a shot is fired. ### Mode switching"
	altMode(choices) : "Alt Mode" : 0 : "When 1, then secondary-attack will toggle between 'def_fireInfo' and 'def_altFireInfo' on primary-attack. ### Burst Fire" =
	[
		0 : "No"
		1 : "Yes"
	]
	burstCount(string) : "Burst Count" : "0" : "Number of bursts to fire. Default is '0'."
	burstTime(string) : "Burst Time" : "" : "Once we've fired 'burstCount' number of times, we'll add this delay after. ### Act overrides Activities are used to decide which animation gets played and which actions are available for this object. If a model does not define them, you can override them here. This system is SUBJECT to change. It may be removed altogether when FTEQW adds a proper activity override format for existing models."
	act_idle(string) : "Act idle" : "" : "Sequences to play when idle."
	act_idleEmpty(string) : "Act idle Empty" : "" : "Sequences to play when idle and with an empty clip."
	act_draw(string) : "Act draw" : "" : "Sequences to play when drawing the weapon."
	act_drawEmpty(string) : "Act draw Empty" : "" : "Sequences to play when drawing the empty weapon."
	act_holster(string) : "Act holster" : "" : "Sequences to play when holstering the weapon."
	act_holsterEmpty(string) : "Act holster Empty" : "" : "Sequences to play when holstering the empty weapon."
	act_fire(string) : "Act fire" : "" : "Sequences to play when 'def_onFire' fires."
	act_fireLast(string) : "Act fire Last" : "" : "Sequences to play when firing the last shot in the weapon."
	act_fireEmpty(string) : "Act fire Empty" : "" : "Sequences to play when failing to fire the weapon."
	act_reload(string) : "Act reload" : "" : "Sequences to play when reloading the weapon."
	act_reloadEmpty(string) : "Act reload Empty" : "" : "Sequences to play when reloading the empty weapon."
	act_reloadStart(string) : "Act reload Start" : "" : "When set will play sequences for the start of a shotgun-style reload."
	act_reloadEnd(string) : "Act reload End" : "" : "Like 'actReloadStart' but for the end of the shotgun-style reload."
	act_delay(string) : "Act delay" : "" : "Sequence to play while the weapon is charging (see 'chargeTime')"
	act_loop(string) : "Act loop" : "" : "Sequence to play while the weapon is still charging, or in a firing-loop."
	act_detonate(string) : "Act detonate" : "" : "Sequences to play when 'detonateOnFire' is triggered."
	act_fireFailed(string) : "Act fire Failed" : "" : "Sequences to play when the melee attack fails."
	act_fireStart(string) : "Act fire Start" : "" : "Sequences to play at the start of a loop/charge attack."
	act_fireStop(string) : "Act fire Stop" : "" : "Sequences to play at the end of a loop/charge attack."
	act_release(string) : "Act release" : "" : "Sequences to play when 'def_onRelease' fires. ### Misc keys"
	reloadTime(string) : "Reload Time" : "" : "Time in seconds between the start/end of a reload."
	reloadTimed(string) : "Reload Timed" : "" : "When '1', reloads run on def times alone, never on view model animation lengths. A shotgun-style reload loads a round at the end of each step and firing interrupts it once a round is in; a magazine reload fills the clip when 'reloadTime' runs out. Both are predicted, and the HUD can read their progress."
	spinUpTime(string) : "Spin Up Time" : "" : "Seconds either fire button must be held (spinning the barrels) before primary fire shoots. Secondary fire only spins. Predicted."
	punchKick(string) : "Punch Kick" : "" : "Source-style kick: each shot sets the view punch to this many degrees up, plus or minus one, and the punch springs back. Predicted."
	reloadStartTime(string) : "Reload Start Time" : "" : "With 'reloadTimed', how long the first round of a shotgun-style reload takes. Defaults to 'reloadTime'."
	detonateOnFire(string) : "Detonate On Fire" : "" : "When set, will detonate all entities of specified classname."
	punchAngle(string) : "Punch Angle" : "" : "Weapon punchangle to be applied to the camera when shooting 'def_onFire'."
	fireRate(string) : "Fire Rate" : "" : "Firing rate between shots."
	semiAuto(string) : "Semi Auto" : "" : "If not set to '1', the weapon will be fully automatic."
	serverFire(string) : "Server Fire" : "" : "If set to '1', the client doesn't predict this fireInfo's shots. For weapons whose game code decides on the server when to fire (e.g. hold to charge, fire on release), where a predicted shot would be wrong."
]

