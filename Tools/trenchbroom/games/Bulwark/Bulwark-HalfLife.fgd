@PointClass base(NuclideIO, BulwarkScripted) color(255 128 0) size(-8 -8 -8, 8 8 8) = env_spark : "Creates a series (or just one) spark effect with sound when triggered. Notes: The spawnflag START_ON (32) automatically enables the TOGGLE (64) flag as well."
