// Bulwark: Half-Life (Rad-Therapy) and Sven Co-op style co-op
// Generated by build_fgd.py from the game's QuakeC, entityDef and script
// sources plus shared/*.fgd. Edit those and rebuild; edits here are lost.

// ---- common.fgd
// Shared by every profile: Nuclide's entity I/O, the engine's worldspawn keys,
// and the keys the map compilers read (q3map2 for Q3 BSP, ericw-tools for
// Quake BSP2, VHLT for Half-Life BSP30, plus the Source keys converted maps
// carry). Compilers ignore keys they don't know, so one map can carry all of
// them.

// ------------------------------------------------------------------ I/O


@BaseClass = NuclideIO
[
	parentname(target_destination) : "Parent" : "" : "Entity to move with (Source's parentname). 'movewith' is the Spirit of Half-Life spelling."
	movewith(target_destination) : "Move with (SoHL)" : "" : "Spirit of Half-Life's name for parentname."
	script_gametype(string) : "Game types" : "" : "Only spawn in these game types (space separated). Empty spawns in every one."
	output OnSpawn(void) : "Fired when the entity spawns."
	output OnKilled(void) : "Fired when the entity is removed or killed."
	output OnTrigger(void) : "Fired when the entity is triggered."
	output OnUser1(void) : "Fired by the FireUser1 input."
	output OnUser2(void) : "Fired by the FireUser2 input."
	output OnUser3(void) : "Fired by the FireUser3 input."
	output OnUser4(void) : "Fired by the FireUser4 input."
	input FireUser1(void) : "Fires OnUser1."
	input FireUser2(void) : "Fires OnUser2."
	input FireUser3(void) : "Fires OnUser3."
	input FireUser4(void) : "Fires OnUser4."
	input Use(void) : "Uses (triggers) the entity."
	input Kill(void) : "Removes the entity."
	input KillHierarchy(void) : "Removes the entity and everything parented to it."
	input SetParent(string) : "Parents the entity to the named entity."
	input SetParentAttachment(string) : "Attaches the entity to the named attachment of its parent."
	input ClearParent(void) : "Removes the parent."
	input SetOrigin(string) : "Moves the entity to 'x y z'."
	input Show(void) : "Makes the entity visible."
	input Hide(void) : "Makes the entity invisible."
	input Respawn(void) : "Respawns the entity."
	input DropToFloor(void) : "Drops the entity to the floor below it."
	input SpawnDef(string) : "Spawns the named entityDef at the entity."
]


// ------------------------------------------------------------------ worldspawn


@BaseClass = WorldEngine
[
	_fog(string) : "Fog" : "" : "Fog in the playable area: 'density r g b [alpha depthbias]'. 'fog' is read too."
	_waterfog(string) : "Water fog" : "" : "Fog under water: 'density r g b [alpha depthbias]'. 'waterfog' is read too."
	_skyroomfog(string) : "Sky room fog" : "" : "Fog in the sky_camera area: 'density r g b [alpha depthbias]'."
	skyname(string) : "Sky" : "" : "Sky box name, looked up under gfx/env/ and as a material ('sky' is read too)."
	gridsize(string) : "Light grid size" : "64 64 128" : "Size of the Q3 BSP light grid cells (used by q3map2 and the renderer)."
	light(string) : "Minimum light (Quake)" : "" : "Quake-style minimum light level for the whole map."
	_tb_def(string) : "Entity definitions" : "" : "Set by TrenchBroom: which entity definition file the map uses."
	_tb_mod(string) : "Mods" : "" : "Set by TrenchBroom: extra game directories loaded for this map."
]



@BaseClass = WorldCompile
[
	// q3map2
	_blocksize(string) : "q3map2: BSP block size" : "" : "q3map2: size of the BSP split blocks, 'x y z' or one number. 0 turns blocking off."
	_ambient(string) : "q3map2/ericw: ambient light" : "" : "Light added to every surface."
	_minlight(string) : "Minimum light" : "" : "q3map2 and ericw: no lightmap goes darker than this."
	_minvertexlight(string) : "q3map2: minimum vertex light" : "" : "q3map2: minimum light for vertex-lit surfaces."
	_mingridlight(string) : "q3map2: minimum grid light" : "" : "q3map2: minimum light in the light grid."
	_color(color1) : "Ambient/minlight colour" : "" : "Colour of _ambient and _minlight (0-1 RGB)."
	_keepLights(choices) : "q3map2: keep lights" : 0 : "q3map2: keep light entities in the compiled BSP, so the game can read them (Nuclide uses them for dynamic lights)." =
	[
		0 : "No"
		1 : "Yes"
	]
	_noshadersun(choices) : "q3map2: ignore shader suns" : 0 : "q3map2: ignore q3map_sun in sky shaders." =
	[
		0 : "No"
		1 : "Yes"
	]
	_farplanedist(string) : "q3map2: far plane distance" : "" : "q3map2: vis culls anything further than this. Use with fog."
	_foghull(string) : "q3map2: fog hull" : "" : "q3map2: material drawn on the fog hull with _farplanedist."
	_floodlight(string) : "q3map2: floodlight" : "" : "q3map2 -floodlight colour and settings: 'r g b distance intensity'."
	_celshader(string) : "q3map2: cel shader" : "" : "q3map2: cel shading material for the whole world."
	_lightmapscale(string) : "Lightmap scale" : "" : "q3map2 (_lightmapscale) and ericw (_lightmap_scale): lightmap texel size multiplier."
	// ericw-tools (light)
	_sunlight(string) : "ericw: sun brightness" : "" : "ericw light: brightness of the sun."
	_sun_mangle(string) : "ericw: sun angles" : "" : "ericw light: sun direction as 'yaw pitch roll'."
	_sunlight_color(color255) : "ericw: sun colour" : "" : "ericw light: sun colour."
	_sunlight_penumbra(string) : "ericw: sun penumbra" : "" : "ericw light: sun penumbra width in degrees."
	_sunlight2(string) : "ericw: sky dome light" : "" : "ericw light: brightness of the light from the whole sky."
	_sunlight2_color(color255) : "ericw: sky dome colour" : "" : "ericw light: colour of the sky dome light."
	_dirt(choices) : "ericw: dirtmapping (AO)" : 0 : "ericw light: ambient occlusion. -1 disables it even when -dirt is passed." =
	[
		-1 : "Off"
		0 : "Default"
		1 : "On"
	]
	_dirtdepth(string) : "ericw: dirt depth" : "" : ""
	_dirtscale(string) : "ericw: dirt scale" : "" : ""
	_dirtgain(string) : "ericw: dirt gain" : "" : ""
	_bounce(choices) : "ericw: bounce light" : 0 : "ericw light: one bounce of indirect light." =
	[
		0 : "Off"
		1 : "On"
	]
	_bouncescale(string) : "ericw: bounce scale" : "" : ""
	_anglescale(string) : "ericw: angle scale" : "" : "ericw light: how much the light's angle of incidence matters (0-1)."
	_gamma(string) : "ericw: gamma" : "" : ""
	_range(string) : "ericw: range" : "" : "ericw light: scales every light's brightness."
	_phong(choices) : "Phong shading (world)" : 0 : "ericw: smooth the world's lighting across faces up to _phong_angle." =
	[
		0 : "Off"
		1 : "On"
	]
	_phong_angle(float) : "Phong angle" : "89" : ""
	// VHLT
	zhlt_wadautodetect(choices) : "VHLT: only used WADs" : 0 : "VHLT: embed or reference only the WADs whose textures the map uses." =
	[
		0 : "No"
		1 : "Yes"
	]
	_tb_textures(string) : "TrenchBroom texture dirs" : "" : "Set by TrenchBroom."
]


// ------------------------------------------------------------------ brush entities


@BaseClass = BrushCompile
[
	// q3map2
	_lightmapscale(string) : "Lightmap scale" : "" : "q3map2: lightmap texel size multiplier for this entity (_ls)."
	_castshadows(choices) : "q3map2: cast shadows" : 0 : "q3map2 (_cs): which entities this entity's brushes shadow." =
	[
		0 : "None"
		1 : "World"
		-1 : "All entities"
	]
	_receiveshadows(choices) : "q3map2: receive shadows" : 1 : "q3map2 (_rs): whose shadows fall on this entity." =
	[
		0 : "None"
		1 : "World"
		-1 : "All entities"
	]
	_celshader(string) : "q3map2: cel shader" : "" : ""
	_shadeangle(string) : "q3map2: shade angle" : "" : "q3map2: smooth vertex normals across faces up to this angle (phong)."
	// ericw-tools
	_phong(choices) : "ericw: phong shading" : 0 : "" =
	[
		0 : "Off"
		1 : "On"
	]
	_phong_angle(float) : "ericw: phong angle" : "89" : ""
	_minlight(string) : "Minimum light" : "" : "ericw and Nuclide: minimum light on this entity."
	_shadow(choices) : "ericw: casts shadows" : 0 : "ericw: brush entities don't cast shadows unless this is set." =
	[
		0 : "No"
		1 : "Yes"
		-1 : "Never"
	]
	_shadowself(choices) : "ericw: shadows itself" : 0 : "" =
	[
		0 : "No"
		1 : "Yes"
	]
	_dirt(choices) : "ericw: dirt" : 0 : "" =
	[
		-1 : "Off"
		0 : "Default"
		1 : "On"
	]
	_lmscale(string) : "ericw: lightmap scale" : "" : "ericw (BSPX LMSCALE): lightmap texel size for this entity, 16 by default."
	_mirrorinside(choices) : "ericw: mirror inside" : 0 : "ericw qbsp: also draw the faces from inside (for water and glass)." =
	[
		0 : "No"
		1 : "Yes"
	]
	// VHLT
	zhlt_lightflags(choices) : "VHLT: light flags" : 0 : "VHLT hlrad: how this entity takes and blocks light." =
	[
		0 : "Normal"
		1 : "Embedded fix"
		2 : "Opaque (blocks light)"
		3 : "Opaque + embedded fix"
		6 : "Opaque + concave fix"
	]
	zhlt_noclip(choices) : "VHLT: not solid" : 0 : "VHLT: build no clip hulls for this entity." =
	[
		0 : "No"
		1 : "Yes"
	]
	zhlt_invisible(choices) : "VHLT: invisible" : 0 : "VHLT: solid but not drawn." =
	[
		0 : "No"
		1 : "Yes"
	]
	zhlt_customshadow(string) : "VHLT: shadow strength" : "" : "VHLT hlrad: 0 to 1, how much light this entity lets through."
	zhlt_embedlightmap(choices) : "VHLT: embed lightmap" : 0 : "VHLT: bake the lightmap into the texture (for translucent brushes)." =
	[
		0 : "No"
		1 : "Yes"
	]
	zhlt_usemodel(target_destination) : "VHLT: use model of" : "" : "VHLT: share the named brush entity's model."
	light_origin(target_destination) : "Light origin" : "" : "HL/VHLT: light this brush entity as if it stood at the named info_target."
]


// ------------------------------------------------------------------ lights


@BaseClass = LightCompile
[
	// q3map2 / ericw
	_deviance(string) : "Penumbra (deviance)" : "" : "q3map2 and ericw: jitter light samples over this many units for soft shadows."
	_samples(string) : "Penumbra samples" : "" : "q3map2 and ericw: samples taken with _deviance."
	_filterradius(string) : "q3map2: filter radius" : "" : "q3map2: blur the light's shadows over this many units."
	_sun(choices) : "q3map2: sun" : 0 : "q3map2: a targeted light that acts as a sun (parallel light)." =
	[
		0 : "No"
		1 : "Yes"
	]
	_anglescale(string) : "Angle scale" : "" : "ericw: how much the angle of incidence matters (0-1)."
	wait(string) : "ericw: falloff scale" : "" : "ericw light: scales the light's falloff distance."
	delay(choices) : "ericw: falloff" : 0 : "ericw light: attenuation formula." =
	[
		0 : "Linear"
		1 : "Inverse distance"
		2 : "Inverse square"
		3 : "None (constant)"
		4 : "Local minlight"
		5 : "Inverse square B"
	]
	mangle(string) : "ericw: spot direction" : "" : "ericw: spotlight direction as 'yaw pitch roll'."
	_softangle(string) : "ericw: spot soft angle" : "" : "ericw: inner cone of a spotlight."
	_surface(string) : "ericw: surface light" : "" : "ericw: copy this light onto every face with this texture."
	_surface_offset(string) : "ericw: surface light offset" : "" : ""
	_project_texture(string) : "ericw: projected texture" : "" : "ericw: project this texture from the light."
	_dirt(choices) : "ericw: dirt" : 0 : "" =
	[
		-1 : "Off"
		0 : "Default"
		1 : "On"
	]
	_bouncescale(string) : "ericw: bounce scale" : "" : ""
	_falloff(string) : "ericw: falloff distance" : "" : "ericw: distance at which a linear light reaches zero."
	// Source (converted maps, and Source-style lighting in Nuclide)
	_light(color255) : "Source: colour and brightness" : "" : "Source: 'r g b brightness' (0-255)."
	_lightHDR(string) : "Source: HDR colour" : "" : "Source: 'r g b brightness' for HDR, -1 -1 -1 1 copies _light."
	_lightscaleHDR(string) : "Source: HDR scale" : "" : ""
	_constant_attn(string) : "Source: constant attenuation" : "" : ""
	_linear_attn(string) : "Source: linear attenuation" : "" : ""
	_quadratic_attn(string) : "Source: quadratic attenuation" : "" : ""
	_fifty_percent_distance(string) : "Source: 50% distance" : "" : ""
	_zero_percent_distance(string) : "Source: 0% distance" : "" : ""
	_hardfalloff(string) : "Source: hard falloff" : "" : ""
	_distance(string) : "Source: max distance" : "" : ""
]


// ---- bulwark.fgd
// Bulwark engine features: the script layer (Lua 5.4, JavaScript and QuakeC,
// modelled on Valve's VScript) and the engine's own worldspawn keys.
// See docs/spec/scripting.md in the bulwark-engine repo.
//
// Script keys are read by Nuclide's ncIO through Bulwark's script builtins
// (src/common/c_script.h in Nuclide). A progs built from a Nuclide without
// those hooks ignores them, and FTEQW ignores them too.


@BaseClass = BulwarkScripted
[
	vscripts(string) : "Entity scripts" : "" : "Space separated script files loaded into this entity's own scope when it spawns. scripts/vscripts/ is searched first; a name with no extension tries .lua, .js and .dat. Precache() runs once they load, OnPostSpawn() once every map entity exists."
	thinkfunction(string) : "Think function" : "" : "Script function called every 0.1 s. Returning a number above zero sets the delay to the next call."
	input RunScriptCode(string) : "Runs code in this entity's scope, in its script's language (or script_language)."
	input RunScriptCodeQuotable(string) : "RunScriptCode with ' turned into a double quote (map values can't hold double quotes)."
	input RunScriptFile(string) : "Runs a script file in this entity's scope."
	input CallScriptFunction(string) : "Calls a function this entity's scripts define."
	input SetThinkFunction(string) : "Sets the think function; empty stops it."
	input AddThinkFunction(string) : "Same as SetThinkFunction."
]



@BaseClass = WorldBulwark
[
	vscripts(string) : "World scripts" : "" : "Scripts loaded into the root scope (the world). scripts/vscripts/mapspawn.lua and mapspawn.js run there for every map, just before the entities spawn."
	_terrain_generated(string) : "Generated terrain" : "" : "Set by Bulwark on .hmp terrain maps; leave it alone."
]



// ---- keys of the QuakeC classes entityDefs spawn as

@BaseClass = Def_cycler
[
	targetname(target_source) : "Targetname" : "" : "Name"
	target(target_destination) : "Target" : "" : "Target when triggered."
	killtarget(target_destination) : "Killtarget" : "" : "Target to kill when triggered."
	angles(string) : "Angles" : "" : "Sets the pitch, yaw and roll angles of the model."
	sequence(string) : "Sequence" : "" : "Sets the animation the model should start in."
	model(string) : "Model" : "" : "Model file that will be displayed by the entity."
]

@BaseClass = Def_env_sprite
[
	targetname(target_source) : "Targetname" : "" : "Name"
	target(target_destination) : "Target" : "" : "Target when triggered."
	killtarget(target_destination) : "Killtarget" : "" : "Target to kill when triggered."
	angles(string) : "Angles" : "" : "Sets the pitch, yaw and roll angles of the sprite."
	model(string) : "Model" : "" : "Path to the sprite in question."
	material(string) : "Material" : "" : "Instead of model, you can set the path of a material/image here."
	rendercolor(color255) : "Rendercolor" : "" : "Color modifier of the sprite."
	renderamt(string) : "Renderamt" : "" : "Alpha modifier of the sprite."
	rendermode(string) : "Rendermode" : "" : "Render mode of the sprite."
	framerate(string) : "Framerate" : "" : "Rate between frames in seconds."
	scale(string) : "Scale" : "" : "Scale modifier of the sprite."
	spawnflags(flags) =
	[
		1 : "ENVS_STARTON" : 0 : "Start visible."
		2 : "ENVS_PLAYONCE" : 0 : "Play once from start to finish, then make invisible."
	]
]

@BaseClass = Def_hlWeapon
[
]

@BaseClass = Def_info_player_coop
[
	targetname(target_source) : "Targetname" : "" : "Name"
]

@BaseClass = Def_info_player_deathmatch
[
	targetname(target_source) : "Targetname" : "" : "Name"
]

@BaseClass = Def_info_player_start
[
	targetname(target_source) : "Targetname" : "" : "Name"
]

@BaseClass = Def_ncItem
[
	targetname(target_source) : "Targetname" : "" : "Name"
	model(string) : "Model" : "" : "world model."
	model_view(string) : "Model view" : "" : "view model."
	model_world(string) : "Model world" : "" : "same as model."
	model_player(string) : "Model player" : "" : "(Optional) when equipped, will use this model."
	inv_name(string) : "Inv name" : "" : "Fancy title. Can be a localized string."
	inv_weapon(string) : "Inv weapon" : "" : "name of the weapon to give on pickup. can be the same as this entitydef."
	inv_health(string) : "Inv health" : "" : "How much health points to give on pick-up."
	inv_armor(string) : "Inv armor" : "" : "How much armor points to give on pick-up."
	no_touch(string) : "No touch" : "" : "If 1, will have to be triggered to be given to the activator."
	inv_carry(string) : "Inv carry" : "" : "If 1, will not use the item instantly."
	inv_icon(string) : "Inv icon" : "" : "Material for HUD graphics."
	requires(string) : "Requires" : "" : "Name of the item that has to be present in the players inventory in order to be picked up."
	frame(string) : "Frame" : "" : "Animation sequence to use when it's a pickup."
	hidden_frame(string) : "Hidden frame" : "" : "Animation sequence to use when it was picked up. Will not hide the entity when set."
	physics(string) : "Physics" : "" : "This pickup uses physics to interact with the world."
	mins(string) : "Mins" : "" : "Collision box mins (e.g. '-16 -16 -16') for the item."
	maxs(string) : "Maxs" : "" : "Collision box mins (e.g. '16 16 16') for the item."
	snd_acquire(string) : "Snd acquire" : "" : "Sound to play when picked up successfully."
	snd_respawn(string) : "Snd respawn" : "" : "Sound to play when it respawns."
	spin(string) : "Spin" : "" : "Pickup will spin when set."
	floating(string) : "Floating" : "" : "Item does not drop to floor."
	body(string) : "Body" : "" : "GoldSrc Body/Geomset to use."
	respawn(string) : "Respawn" : "" : "Time required for a map-placed version of this item to respawn."
	input SetRespawnTime(void) : "Sets the time required for a map-placed version of this item to respawn."
]

@BaseClass = Def_ncMonster
[
	targetname(target_source) : "Targetname" : "" : "Name"
	netname(string) : "Netname" : "" : "Name used for obituaries and debug info."
	maxs(string) : "Maxs" : "" : "Bounding box mins."
	mins(string) : "Mins" : "" : "Bounding box maxs. ## KEYS - TRIGGERS"
	TriggerCondition(string) : "Trigger Condition" : "" : "See triggerCondition_t for which numerical values to pick."
	TriggerTarget(target_destination) : "Trigger Target" : "" : "Will trigger this entity when TriggerCondition (triggerCondition_t) is met. ## KEYS - BEHAVIOUR"
	health(string) : "Health" : "" : "Starting health."
	dead(string) : "Dead" : "" : "Whether to start the monster in a dead state (0 or 1)."
	team(string) : "Team" : "" : "Alliance. See allianceState_t for which numerical values to pick."
	speed_walk(string) : "Speed walk" : "" : "Walk speed in units per second."
	speed_run(string) : "Speed run" : "" : "Run speed in units per second."
	eye_height(string) : "Eye height" : "" : "Height in units at which to place the eyes from the origin. Use the cvar r_showViewCone to debug it."
	snd_sight(string) : "Snd sight" : "" : "SoundDef to play upon 'alert'."
	snd_idle(string) : "Snd idle" : "" : "SoundDef to play when the monster is idle."
	idle_min(string) : "Idle min" : "" : "Min idle delay in seconds."
	idle_max(string) : "Idle max" : "" : "Max idle delay in seconds."
	snd_footstep(string) : "Snd footstep" : "" : "Which soundDef to play when a footstep should occur."
	snd_chatter(string) : "Snd chatter" : "" : "An idle type soundDef to play."
	snd_chatter_combat(string) : "Snd chatter combat" : "" : "An idle type soundDef, only during combat."
	snd_pain(string) : "Snd pain" : "" : "SoundDef to play when in pain."
	snd_death(string) : "Snd death" : "" : "SoundDef to play when death settles in."
	snd_thud(string) : "Snd thud" : "" : "SoundDef to play when the monster falls to the ground. ## KEYS - ATTACK (MELEE)"
	def_attack_melee(string) : "Def attack melee" : "" : "Which entityDef to look into for a melee attack. [CONTINUED]"
	attack_melee_range(string) : "Attack melee range" : "" : "Range under which melee attacks occur."
	snd_melee_attack(string) : "Snd melee attack" : "" : "SoundDef to play when melee attacking."
	snd_melee_attack_hit(string) : "Snd melee attack hit" : "" : "SoundDef to play when a successful melee attack occurs."
	snd_melee_attack_miss(string) : "Snd melee attack miss" : "" : "SoundDef to play when a melee attack misses. ## KEYS - ATTACK (RANGED)"
	def_attack_ranged_1(string) : "Def attack ranged 1" : "" : "EntityDef that contains primary ranged attack info."
	attack_ranged1_range(string) : "Attack ranged1 range" : "" : "Range for the primary ranged attack."
	def_attack_ranged_2(string) : "Def attack ranged 2" : "" : "EntityDef that contains secondary ranged attack info."
	attack_ranged2_range(string) : "Attack ranged2 range" : "" : "Range for the secondary ranged attack."
	attack_ranged_min(string) : "Attack ranged min" : "" : "The primary ranged attack isn't used on enemies closer than this (default 0)."
	attack_ranged_dot(string) : "Attack ranged dot" : "" : "The enemy must be within this cone in front of us, as a flat dot product, before a ranged attack (default -1, anywhere)."
	attack_ranged_onground(string) : "Attack ranged onground" : "" : "Only attack at range while standing on the ground (default 0)."
	attack_melee_dot(string) : "Attack melee dot" : "" : "The same cone check for melee attacks (default -1, anywhere)."
	snd_ranged_attack(string) : "Snd ranged attack" : "" : "SoundDef to play upon ranged attack."
	reload_count(string) : "Reload count" : "" : "how many ranged attacks until reload. Only affects primary ranged attacks."
	reload_delay(string) : "Reload delay" : "" : "Time between reloads in seconds. Requires `reload_count` to be set > 0."
	snd_reload(string) : "Snd reload" : "" : "SoundDef to play when reloading."
	reserve_ammo(string) : "Reserve ammo" : "" : "The amount of reserve ammo. -1 is infinite (default)"
	attack_cone(string) : "Attack cone" : "" : "Cone in which to attack."
	attack_accuracy(string) : "Attack accuracy" : "" : "Accuracy (or rather, lack of) multiplier. ## KEYS - ATTACK (SPECIAL)"
	def_attack_special_1(string) : "Def attack special 1" : "" : "EntityDef that contains primary special attack info. Intended for projectiles."
	attack_special1_range(string) : "Attack special1 range" : "" : "Range for the primary special attack."
	num_projectiles(string) : "Num projectiles" : "" : "The number of primary special projectiles to shoot."
	projectile_spread(string) : "Projectile spread" : "" : "Spread of the projectiles. 0 is none. 1 is the max."
	projectile_delay(string) : "Projectile delay" : "" : "Delay in seconds until a special attack projectile is thrown."
	weapon_drawn(string) : "Weapon drawn" : "" : "Whether or not the weapon is drawn by default. Either 0 or 1."
	body_on_draw(string) : "Body on draw" : "" : "Which bodygroup to switch to when the monster has drawn its weapon."
	leap_damage(string) : "Leap damage" : "" : "Amount of damage appled when the enemy leaps towards you and hits."
	spawnflags(flags) =
	[
		1 : "WAITTILLSEEN" : 0 : "- Play scripted sequence only once the monster gets seen by a player."
		2 : "GAG" : 0 : "- Won't speak."
		4 : "MONSTERCLIP" : 0 : "- Interacts with monsterclips?"
		16 : "PRISONER" : 0 : "- Never used."
		64 : "IGNOREPLAYER" : 0 : "- Ignores the player. Like 'notarget'."
		128 : "WAITFORSCRIPT" : 0 : "- Does nothing, until a scripted sequence runs on the monster. Then becomes alive."
		256 : "PREDISASTER" : 0 : "- Special flag used in Half-Life."
		512 : "FADECORPSE" : 0 : "- Corpse will disappear on its own."
		1024 : "MULTIPLAYER" : 0 : "- Available in multiplayer."
		2048 : "FALLING" : 0 : "- Will not drop to the floor upon level spawn - but fall when in-game."
		4096 : "HORDE" : 0 : "- Never used."
	]
	input Sleep(void) : "Puts the AI routines to sleep."
	input Wake(void) : "Wakes the actor up from induced sleep."
	input StartScripting(void) : "Forces the monster into a scripted sequence state."
	input GagEnable(void) : "Supress dialogue."
	input GagDisable(void) : "Enable dialogue."
	input Wait(void) : "Idle for this many seconds."
	input WaitRandom(string) : "Idle for up to this many seconds. Random value."
	input WaitIndefinitely(void) : "Wait forever."
	input PlayActivity(void) : "Plays a named activity. E.g. 'idle' or 'run'."
	input PlaySequence(void) : "Plays a named sequence, must be exact. E.g. 'shoot_mp5_alt'"
	input FindCoverFromEnemy(void) : "Plots a route to a cover position away from its current enemy."
	input SetSequenceMovementSpeed(void) : "Sets the movement speed in units-per-second for any route plotting."
	input AlertNearbyToSchedule(void) : "Alerts friendlies nearby and informs them of our named 'mindset'."
	input WaitForMovement(void) : "Wait until the current movement operation is complete."
	input SetFailSchedule(void) : "Overrides which schedule to play when the currently active schedule fails to finish."
	input Remember(void) : "Remember something. Reserved."
	input WaitPVS(void) : "Wait until a player enters our PVS. Stops all expensive operations."
	input StopMovement(void) : "Stops any movement on this actor."
	input TurnLeft(void) : "Request the monster to turn left by a specified angle."
	input TurnRight(void) : "Request the monster to turn right by a specified angle."
	input TurnToIdealPosition(void) : "Request the monster to turn to the most ideal position."
	input TurnToEnemy(void) : "Request the monster to turn towards the enemy."
	input AttackMelee1(void) : "Request to perform the first variant of the melee attack."
	input AttackMelee2(void) : "Request to perform the second variant of the melee attack."
	input AttackRanged1(void) : "Request to perform the first variant of the ranged attack."
	input AttackRanged2(void) : "Request to perform the second variant of the ranged attack."
	input HordeOn(void) : "Enables horde mode on the monster. It will always know where you are."
	input HordeOff(void) : "Disabled the horde mode on the monster."
]

@BaseClass = Def_ncTalkMonster
[
	targetname(target_source) : "Targetname" : "" : "Name"
	netname(string) : "Netname" : "" : "Name used for obituaries and debug info."
	maxs(string) : "Maxs" : "" : "Bounding box mins."
	mins(string) : "Mins" : "" : "Bounding box maxs. ## KEYS - SENTENCES"
	talk_answer(string) : "Talk answer" : "" : "SentenceDef to play when they're providing a generic answer to a question."
	talk_ask(string) : "Talk ask" : "" : "SentenceDef to play when they're asking a question."
	talk_ally_shot(string) : "Talk ally shot" : "" : "SentenceDef to play when they're commenting on an ally being shot."
	talk_greet(string) : "Talk greet" : "" : "SentenceDef to play when greeting an ally."
	talk_idle(string) : "Talk idle" : "" : "SentenceDef to play when idling about."
	talk_panic(string) : "Talk panic" : "" : "SentenceDef to play when the state from being calm changes to being fearful."
	talk_hearing(string) : "Talk hearing" : "" : "SentenceDef to play when commenting on a suspicious noise."
	talk_smelling(string) : "Talk smelling" : "" : "SentenceDef to play when commenting on a suspicious smell."
	talk_stare(string) : "Talk stare" : "" : "SentenceDef to play when commenting on the player staring at them."
	talk_survived(string) : "Talk survived" : "" : "SentenceDef to play when they've survived an attack."
	talk_wounded(string) : "Talk wounded" : "" : "SentenceDef to play when they've been severely wounded."
	talk_alert(string) : "Talk alert" : "" : "SentenceDef to play when they've become alerted."
	talk_player_ask(string) : "Talk player ask" : "" : "SentenceDef to play when they want to ask the player a question."
	talk_player_greet(string) : "Talk player greet" : "" : "SentenceDef to play when they want to greet the player."
	talk_player_idle(string) : "Talk player idle" : "" : "SentenceDef to play when they hang around the player."
	talk_player_wounded1(string) : "Talk player wounded1" : "" : ""
	talk_player_wounded2(string) : "Talk player wounded2" : "" : ""
	talk_player_wounded3(string) : "Talk player wounded3" : "" : ""
	talk_unfollow(string) : "Talk unfollow" : "" : "SentenceDef to play for when they're choosing to unfollow someone."
	talk_follow(string) : "Talk follow" : "" : "SentenceDef to play for when they're choosing follow someone."
	talk_stop_follow(string) : "Talk stop follow" : "" : "SentenceDef to play for when they're being asked to unfollow someone."
	talk_deny_follow(string) : "Talk deny follow" : "" : "SentenceDef to play for when they're denying the follow request."
	follow_on_use(string) : "Follow on use" : "" : "Can be either 0 or 1, will decide if they can follow someone."
	follow_dist(string) : "Follow dist" : "" : "Distance between the it and the player its following."
	follow_maxdist(string) : "Follow maxdist" : "" : "Maximum distance between it and the player before giving up following them. For more keys, see ncMonster."
	spawnflags(flags) =
	[
		1 : "WAITTILLSEEN" : 0 : "WAITTILLSEEN"
		2 : "GAG" : 0 : "GAG"
		4 : "MONSTERCLIP" : 0 : "MONSTERCLIP"
		16 : "PRISONER" : 0 : "PRISONER"
		64 : "IGNOREPLAYER" : 0 : "IGNOREPLAYER"
		128 : "WAITFORSCRIPT" : 0 : "WAITFORSCRIPT"
		256 : "PREDISASTER" : 0 : "PREDISASTER"
		512 : "FADECORPSE" : 0 : "FADECORPSE"
		1024 : "MULTIPLAYER" : 0 : "MULTIPLAYER"
		2048 : "FALLING" : 0 : "FALLING"
		4096 : "HORDE" : 0 : "HORDE"
	]
]

