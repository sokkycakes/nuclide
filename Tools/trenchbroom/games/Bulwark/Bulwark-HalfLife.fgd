	renderamt(string) : "Renderamt" : "" : "Render-Amount the target changes to."
	rendercolor(color255) : "Rendercolor" : "" : "Render-Color the target changes to."
	renderfx(string) : "Renderfx" : "" : "Render-FX the target changes to."
	spawnflags(flags) =
	[
		1 : "SF_NORENDERFX" : 0 : "Don't set the Render-FX attribute on the target."
		2 : "SF_NORENDERAMT" : 0 : "Don't set the Render-Amount attribute on the target."
		4 : "SF_NORENDERMODE" : 0 : "Don't set the Render-Mode attribute on the target."
		8 : "SF_NORENDERCOLOR" : 0 : "Don't set the Render-Color attribute on the target."
	]
]

