@SolidClass base(WorldCompile, WorldEngine, WorldBulwark) color(0 0 0) = worldspawn : "Only used for the world. Notes: A map must only have one worldspawn entity. Every game can have varying key definitions for the worldspawn entity. It's also not affected by 'killtarget'."
[
	message(string) : "Message" : "" : "Full title of the map. (e.g. 'Barbie's Domain')"
	author(string) : "Author" : "" : "Author of the map."
	chaptertitle(string) : "Chaptertitle" : "" : "Titles.txt entry to display when entering the level."
	sounds(string) : "Sounds" : "" : "CD track to play. Numerical value. Most likely starts at '2'."
	_fog(string) : "Fog" : "" : "Fog in the playable area. Format: (density red green blue alpha depthbias)"
	_skyroomfog(string) : "Skyroomfog" : "" : "Fog in the skybox area. Format: (density red green blue alpha depthbias)"
	skyname(string) : "Skyname" : "" : "Which skybox to use. (e.g. 'textures/skies/sundown')"
	ambientsound(string) : "Ambientsound" : "" : "Sound shader to play in the background (looping) for when other env_soundscape entities are NOT active."
	startdark(choices) : "Startdark" : 0 : "Starts the level with a fade in similar to using an env_fade, which lasts for nine seconds." =
	[
		0 : "No"
		1 : "Yes"
	]
	hdr_iris_minvalue(string) : "Hdr iris minvalue" : "0.0" : "Minimum HDR brightness adjustment. Default is '0.0'."
	hdr_iris_maxvalue(string) : "Hdr iris maxvalue" : "2.0" : "Maximum HDR brightness adjustment. Default is '2.0'."
	hdr_iris_multiplier(string) : "Hdr iris multiplier" : "1.0" : "HDR effect multiplier. Default is '1.0'."
	hdr_iris_fade_up(string) : "Hdr iris fade up" : "0.1" : "HDR iris fade up speed. Default is '0.1'."
	hdr_iris_fade_down(string) : "Hdr iris fade down" : "0.5" : "HDR iris fade down speed. Default is '0.5'."
	_litwater(string) : "Litwater" : "" : "Set to 1 for a HL BSP to have lightmapped water surfaces."
]

