@PointClass base(NuclideIO, BulwarkScripted) color(255 0 0) size(-8 -8 -8, 8 8 8) = game_text : "This entity displays a message of your choice on-screen. Notes: Line breaks inside 'message' can be added with a /n character."
[
	targetname(target_source) : "Targetname" : "" : "Name"
	message(string) : "Message" : "" : "Text to display. Can be a titles.txt entry."
	x(string) : "X" : "" : "Horizontal position of text. (0 - 1.0 = left to right, -1 = center)"
	y(string) : "Y" : "" : "Vertical position of text. (0 - 1.0 = top to bottom, -1 = center)"
	effect(string) : "Effect" : "" : "Effect to apply to the text. 0 : Fade In/Out; 1 : Credits; 2 : Scan Out"
	color(color255) : "Color" : "" : "The main colour in RGB255."
	color2(color255) : "Color2" : "" : "The highlight colour in RGB255."
	fadein(string) : "Fadein" : "" : "Time taken to fade in each character."
	fadeout(string) : "Fadeout" : "" : "Time taken to fade out message."
	holdtime(string) : "Holdtime" : "" : "Length of time to hold message on screen after fading in."
	fxtime(string) : "Fxtime" : "" : "Time the highlight lags behind the leading edge of the text in seconds."
	channel(string) : "Channel" : "" : "Message channel to use. Meant for overriding messages."
	spawnflags(flags) =
	[
		1 : "GTF_ALLPLAYERS" : 0 : "Broadcast message to all players, not just the activator."
	]
]

