@SolidClass base(NuclideIO, BrushCompile, BulwarkScripted) color(0 128 204) = func_tank : "A mountable tank gun turret type entity. A player (or NPC) can interact with it and shoot it. It's in the same family as the func_tankmortar entity, the difference being that this shoots bullets and not mortar blasts. Notes: I don't like the sprite stuff tacked on at all because of the extra networking involved and because it's so awfully GoldSrc specific. Eventually I need to design a more generic routine that allows people to just refer to materials with the appropriate blend-modes instead of hardcoding that some random sprites needs to be treated additive."
[
	targetname(target_source) : "Targetname" : "" : "Name"
	yawrate(string) : "Yawrate" : "" : "The speed of the left/right movement of the gun."
	yawrange(string) : "Yawrange" : "" : "Range of left/right movement in degrees."
	pitchrate(string) : "Pitchrate" : "" : "The speed of the up/down movement of the gun."
	pitchrange(string) : "Pitchrange" : "" : "Range of up/down movement in degrees."
	barrel(string) : "Barrel" : "" : "Distance from origin to barrel tip in units."
	barrely(string) : "Barrely" : "" : "Horizontal distance origin to the center of the barrel tip."
	barrelz(string) : "Barrelz" : "" : "Vertical distance origin to the center of the barrel tip."
	firerate(string) : "Firerate" : "" : "Number of bullets fired per second."
	bullet_damage(string) : "Bullet damage" : "" : "Damage each fired bullet does."
	firespread(string) : "Firespread" : "" : "Accuracy of the gun. 0 is best, 4 is worst."
	persistance(string) : "Persistance" : "" : "Time in seconds for how long an NPC might continue shooting."
	minRange(string) : "Min Range" : "" : "Minimum range the target can be at for an NPC to fire."
	maxRange(string) : "Max Range" : "" : "Maximum range the target can be at for an NPC to fire."
	spritesmoke(string) : "Spritesmoke" : "" : "Sprite to spawn for 'smoke' when the entity is fired."
	spriteflash(string) : "Spriteflash" : "" : "Sprite to spawn for a 'muzzleflash' when the entity is fired."
	spritescale(string) : "Spritescale" : "" : "Scale multiplier for both smoke and flash sprites."
	rotatesound(string) : "Rotatesound" : "" : "Sound file to play in a loop while barrel is rotating."
	spawnflags(flags) =
	[
		1 : "FNCTANK_ACTIVE" : 0 : "TODO: Start active?"
		16 : "FNCTANK_DIRECTONLY" : 0 : "TODO: ?"
		32 : "FNCTANK_CONTROLLABLE" : 0 : "TODO: Can be interacted with similar to a tankmortar?"
	]
]

