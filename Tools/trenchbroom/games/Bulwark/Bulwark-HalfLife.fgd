@PointClass base(NuclideIO, LightCompile, BulwarkScripted) color(0 255 0) size(-8 -8 -8, 8 8 8) = light : "Infinitely small point of light illuminating the scene. Notes: In idTech 2/GoldSrc etc. `'spawnflag' '1'` in the light entity data means it starts off, disabled, dark. This uses the lightstyle feature from Quake, where an area of a level can be handled by up to 4 overlapping lightmap sheets from lights with different 'style' values. This doesn't exist in idTech3 because lightstyles were not a thing originally. While there are Q3 BSP compilers that try to address this, it's a significant source of of lightmap abuse. As a general piece of advice, please consider using light_dynamic or env_projectedtexture for toggled or flickering lights."
[
	targetname(target_source) : "Targetname" : "" : "Name"
	target(target_destination) : "Target" : "" : "When set, targets an enity instead, becoming a spotlight"
	light(string) : "Light" : "300" : "Light intensity value. Default is '300'"
	color(color1) : "Color" : "1,1,1" : "Normalized RGB color value. Default is [1,1,1]"
	color255(color255) : "Color255" : "" : "RGB255 color value. e.g. '255 255 255' for white"
	extradist(string) : "Extradist" : "" : "The additional distance it should attempt to travel."
	radius(string) : "Radius" : "64" : "Sets the light cone radius for spotlights. Default is '64'"
	fade(string) : "Fade" : "" : "Sets the fade-distance of a light when LFL_LINEAR is set"
	anglescale(string) : "Anglescale" : "" : "Sets the light angle scale of non-linear lights"
	deviance(string) : "Deviance" : "" : "Sets the deviance, jitter effect for each light sample."
	samples(string) : "Samples" : "" : "Number of light samples. This also needs to be set > 0.0 for deviance to work."
	filter(string) : "Filter" : "" : "Setting to blur the light/shadows resulting from this light."
	start_active(choices) : "Start active" : 0 : "Set to either 0 or 1 to tell the light in what mode to start in." =
	[
		0 : "No"
		1 : "Yes"
	]
	style(choices) : "Style" : 0 : "Light style ID. 0-11 are defined, 12-32 are reserved for switched lights. List of pre-defined styles:" =
	[
		0 : "Normal"
		1 : "Flicker A"
		2 : "Slow strong pulse"
		3 : "Candle A"
		4 : "Fast strobe"
		5 : "Gentle pulse"
		6 : "Flicker B"
		7 : "Candle B"
		8 : "Candle C"
		9 : "Slow strobe"
		10 : "Fluorescent flicker"
		11 : "Slow pulse, no black"
	]
	pattern(string) : "Pattern" : "" : "Custom light style pattern. Needs unique light style ID set in the 'style' field (numbers above 32). Patterns are defined with letters of the alphabet. 'a' being dark. 'z' being fully lit. Its string of characters get interpreted as brightness values and are interpolated between at 10 frames-per-second in the game."
	spawnflags(flags) =
	[
		1 : "LFL_LINEAR" : 0 : "Use linear distance falloff instead of inverse-square falloff."
		4 : "LFL_DARK" : 0 : "Darken, instead of illuminating the lightmap."
		8 : "LFL_NOGRID" : 0 : "This light does not affect the lightgrid."
	]
]

@PointClass base(NuclideIO, LightCompile, BulwarkScripted) color(0 255 0) size(-8 -8 -8, 8 8 8) = light_dynamic : "Dynamic light entity. Can be parented to things, it even has some inputs that may be interesting. Notes: The 'start_active' is a Nuclide specific one. There is no way in Source engine games to tell the entity to start inactive as far as I can tell."
[
	targetname(target_source) : "Targetname" : "" : "Name"
	target(target_destination) : "Target" : "" : "Name of an entity in the map that light will point at."
	_light(color255) : "Light" : "" : "Color of the spotlight in RGB255 format."
	brightness(string) : "Brightness" : "" : "Intensity of the spotlight."
	_inner_cone(string) : "Inner cone" : "" : "Angles of the inner spotlight beam. 0 = omnidirectional."
	_cone(string) : "Cone" : "" : "Angles of the outer spotlight beam. 0 = omnidirectional."
	distance(string) : "Distance" : "" : "Distance that light is allowed to cast, in inches."
	spotlight_radius(string) : "Spotlight radius" : "" : "Radius of the resulting spotlight that's cast at a wall."
	style(string) : "Style" : "" : "Select one of the hard-coded lightstyles."
	start_active(choices) : "Start active" : 0 : "Override for if the entity should start on or off." =
	[
		0 : "No"
		1 : "Yes"
	]
	pattern(string) : "Pattern" : "" : "Override the lightstyle pattern with a string."
	input TurnOn(void) : "Turns the light on."
	input TurnOff(void) : "Turns the light off."
	input Toggle(void) : "Toggles the light from an on/off state."
	input Color(void) : "Sets the light color in RGB255 format."
	input SetPattern(void) : "Sets the light pattern in string form! a = dark, z = bright"
]

@PointClass base(NuclideIO, LightCompile, BulwarkScripted) color(0 255 0) size(-8 -8 -8, 8 8 8) = light_environment : "Defines the overall ambient skylight in the map. Notes: Only one is effective per map. Sun light generally is white, unless the atmosphere/horizon is coloring it. The ambientcolor should generally be set to that of the skybox for the most realistic depiction of the world. As mentioned before, the 'sunspreadangle' and 'filterradius' keys only work if 'samples' is set to something higher than 1, as those are parameters for said behaviour. There's no point in setting 'samples' to something higher than 1 if you aren't bothering to supply a valid 'sunspreadangle' and 'filterradius' key either. For cloudly/overcast skies, I'd recommend setting the 'pitch' to '-45', then 'samples' to at least '4' and 'sunspreadangle to '360' with a 'filterradius' of at least '1'. This will ensure that the sunlight will be cast diagonally from 4 positions across the entire horizon - thus eliminating any harsh shadows."
[
	color(color1) : "Color" : "1,1,1" : "Normalized RGB color value. Default is [1,1,1]"
	color255(color255) : "Color255" : "" : "RGB255 color value. e.g. '255 255 255' for white"
	ambientcolor(color1) : "Ambientcolor" : "1,1,1" : "Shadow color. Normalized RGB color value. Default is [1,1,1]"
	ambientcolor255(color255) : "Ambientcolor255" : "" : "Shadow color. RGB255 color value. e.g. '255 255 255' for white"
	intensity(string) : "Intensity" : "" : "Overall intensity of the sky light. '300' is probably okay for a day level."
	sunangle(string) : "Sunangle" : "" : "The yaw position of the sun, basically the horizontal direction."
	pitch(string) : "Pitch" : "" : "The vertical position of the sun. '-90' means straight down, '-45' is diagonal etc."
	samples(string) : "Samples" : "" : "The amount of passes onto the lightmap, this is required for spread."
	sunspreadangle(string) : "Sunspreadangle" : "" : "The offset of each sample pass in degrees, basically horizontal jitter."
	filterradius(string) : "Filterradius" : "" : "Blur amount for each pass. This will make cloud scenes work well."
]

@PointClass base(NuclideIO, LightCompile, BulwarkScripted) color(0 255 0) size(-8 -8 -8, 8 8 8) = light_surface : "Material property modifier related to lighting. Available in our vmap compiler. Notes: Instead of having hundreds of off-shoot materials for your level, you can use this to quickly make sure an existing material is adjusted for your level. The backsplash_fraction key can be set to 100 (percent) to ensure it's mostly illuminated, however since the lights are round you might have some slightly darker parts in the corners of a perfectly square surface. Keep this in mind. If you have round surfaces, especially patches, you should definitely adjust the backsplash_distance key to make sure the light is spawning out far enough. One giant, half circle patch surface might see issues otherwise. Not tested though."
[
	targetname(target_source) : "Targetname" : "" : "Name"
	surfacename(string) : "Surfacename" : "" : "Material to make a light emitting surface."
	light(string) : "Light" : "" : "Light intensity value."
	color(color1) : "Color" : "" : "Normalized RGB color value. E.g. '1.0 1.0 1.0'"
	color255(color255) : "Color255" : "" : "RGB255 color value. E.g. '255 255 255'"
	subdivisions(string) : "Subdivisions" : "" : "Defines how many surfacelights are spawned for this surface."
	bouncescale(string) : "Bouncescale" : "1.0" : "How strong photons will bounce for radiosity operations. Default is 1.0."
	backsplash_fraction(string) : "Backsplash fraction" : "5" : "When > 0, creates a backsplash light that illuminates our material. Default is 5 (percent)."
	backsplash_distance(string) : "Backsplash distance" : "23" : "How many units away from the surface the backsplash light will be placed. Default is 23 (units)."
	style(string) : "Style" : "" : "What lightstyle group the emitted light will belong to."
]

@PointClass base(NuclideIO, BulwarkScripted) color(76 26 153) size(-8 -8 -8, 8 8 8) = logic_achievement : "Unlocks achievements or aids in the progression of them. Notes: Ensure to prefix the value of the `AchievementEvent` key with `ACHIEVEMENT_EVENT_`. For example, if you are using SteamWorks and have your achievement on there named `FOOBAR` then you want the value to be `ACHIEVEMENT_EVENT_FOOBAR`."
[
	targetname(target_source) : "Targetname" : "" : "Name"
	AchievementEvent(string) : "Achievement Event" : "" : "Identifier of the achievement."
	StartDisabled(choices) : "Start Disabled" : 0 : "Entity will have to be enabled in order to work when set to 1." =
	[
		0 : "No"
		1 : "Yes"
	]
	input FireEvent(void) : "Triggers the achievement."
	input Enable(void) : "Enable the entity."
	input Disable(void) : "Disable the entity."
	input Toggle(void) : "Toggles between enabled/disabled states."
	output OnFired(void) : "Triggered when the 'FireEvent' is received."
]

@PointClass base(NuclideIO, BulwarkScripted) color(255 0 0) size(-8 -8 -8, 8 8 8) = logic_auto : "Will automatically trigger its outputs when the level has spawned. This is Source's variant of trigger_auto. If you want to talk to old-styled targets instead, use that instead. Notes: When a logic_auto is removed via TA_USEONCE it won't survive match respawns. Source Engine behaviour (do not fix): The output 'OnMultiNewMap' is also triggered during round restarts. This would make 'OnMultiNewRound' redundant, however 'OnMultiNewRound' does not get called upon map start."
[
	targetname(target_source) : "Targetname" : "" : "Name"
	globalstate(string) : "Globalstate" : "" : "The env_global state to read before firing."
	spawnflags(flags) =
	[
		1 : "USE_ONCE" : 0 : "Remove itself from the level permanently when activated."
	]
	output OnMapSpawn(void) : "Triggered when the map is loaded for any reason."
	output OnNewGame(void) : "Triggered only when a new game starts on this level."
	output OnLoadGame(void) : "Triggered when the map is loaded via save game."
	output OnMapTransition(void) : "Triggered when we load this map via level transition."
	output OnBackgroundMap(void) : "Triggered if this map is used as a menu background."
	output OnMultiNewMap(void) : "Same as 'OnMapSpawn' but only valid in multiplayer."
	output OnMultiNewRound(void) : "Triggered only during round restarts in multiplayer."
]

@PointClass base(NuclideIO, BulwarkScripted) color(255 0 0) size(-8 -8 -8, 8 8 8) = logic_case : "Compares an input value sent from another entity with one of the constant values defined within this entity. When it matches a given 'case', that same numbered output will get triggered. You can have 16 different cases to test against. Notes: Since we compare strings, case sensitivity and formatting needs to be identical between the InValue data and the entity defined constant values."
[
	targetname(target_source) : "Targetname" : "" : "Name"
	Case01(string) : "Case01" : "" : "Constant value 1."
	Case02(string) : "Case02" : "" : "Constant value 2."
	Case03(string) : "Case03" : "" : "Constant value 3."
	Case04(string) : "Case04" : "" : "Constant value 4."
	Case05(string) : "Case05" : "" : "Constant value 5."
	Case06(string) : "Case06" : "" : "Constant value 6."
	Case07(string) : "Case07" : "" : "Constant value 7."
	Case08(string) : "Case08" : "" : "Constant value 8."
	Case09(string) : "Case09" : "" : "Constant value 9."
	Case10(string) : "Case10" : "" : "Constant value 10."
	Case11(string) : "Case11" : "" : "Constant value 11."
	Case12(string) : "Case12" : "" : "Constant value 12."
	Case13(string) : "Case13" : "" : "Constant value 13."
	Case14(string) : "Case14" : "" : "Constant value 14."
	Case15(string) : "Case15" : "" : "Constant value 15."
	Case16(string) : "Case16" : "" : "Constant value 16."
	input InValue(string) : "Compares the input in the data field with one of the constant values, then firing a matching output."
	input PickRandom(void) : "Triggers a random, valid output."
	input PickRandomShuffle(void) : "Triggers a random, valid output, but without repeats."
	output OnCase01(void) : "Triggered when Case01 matches the InValue input data."
	output OnCase02(void) : "Triggered when Case02 matches the InValue input data."
	output OnCase03(void) : "Triggered when Case03 matches the InValue input data."
	output OnCase04(void) : "Triggered when Case04 matches the InValue input data."
	output OnCase05(void) : "Triggered when Case05 matches the InValue input data."
	output OnCase06(void) : "Triggered when Case06 matches the InValue input data."
	output OnCase07(void) : "Triggered when Case07 matches the InValue input data."
	output OnCase08(void) : "Triggered when Case08 matches the InValue input data."
	output OnCase09(void) : "Triggered when Case09 matches the InValue input data."
	output OnCase10(void) : "Triggered when Case10 matches the InValue input data."
	output OnCase11(void) : "Triggered when Case11 matches the InValue input data."
	output OnCase12(void) : "Triggered when Case12 matches the InValue input data."
	output OnCase13(void) : "Triggered when Case13 matches the InValue input data."
	output OnCase14(void) : "Triggered when Case14 matches the InValue input data."
	output OnCase15(void) : "Triggered when Case15 matches the InValue input data."
	output OnCase16(void) : "Triggered when Case16 matches the InValue input data."
]

@PointClass base(NuclideIO, BulwarkScripted) color(255 0 0) size(-8 -8 -8, 8 8 8) = logic_relay : "Triggers outputs within an I/O system chain, which can be enabled/disabled at will. Notes: When a logic_relay is removed via spawnflag ONCE it won't survive match respawns."
[
	targetname(target_source) : "Targetname" : "" : "Name"
	StartDisabled(choices) : "Start Disabled" : 0 : "Whether the entity starts disabled." =
	[
		0 : "No"
		1 : "Yes"
	]
	spawnflags(flags) =
	[
		1 : "ONCE" : 0 : "Remove itself from the level permanently when activated."
		2 : "FAST" : 0 : "Allow retriggering even when not all outputs are done firing."
	]
	input Enable(void) : "Enable the logic_relay. Allowing it to be triggered."
	input Disable(void) : "Disable the logic_relay. Prevent it from being triggered."
	input Trigger(void) : "Trigger the logic_relay. Will fire the OnTrigger output."
	input Toggle(void) : "Toggle between Enabled/Disabled."
	input CancelPending(void) : "Not yet implemented. Will cancel any outputs currently scheduled to trigger."
	input EnableRefire(void) : "Not yet implemented. Will be called on itself automatically after all outputs finish their job."
	output OnSpawn(void) : "Triggered when the map is loaded for any reason."
	output OnTrigger(void) : "Triggered only when a new game starts on this level."
]

@PointClass base(NuclideIO, BulwarkScripted) color(255 0 0) size(-8 -8 -8, 8 8 8) = logic_timer : "Will trigger its outputs at fixed/random intervals, much like the entity random_trigger."
[
	targetname(target_source) : "Targetname" : "" : "Name"
	UseRandomTime(string) : "Use Random Time" : "" : "Boolean value that determines whether it's random, or fixed."
	LowerRandomBound(string) : "Lower Random Bound" : "" : "The lower limit of a random trigger timer."
	UpperRandomBound(string) : "Upper Random Bound" : "" : "The upper limit of a random trigger timer."
	RefireTime(string) : "Refire Time" : "" : "Fixed time in seconds. Only when UseRandomTime is set to 0."
	StartDisabled(choices) : "Start Disabled" : 0 : "Boolean value that determines whether we should not start triggering at level start." =
	[
		0 : "No"
		1 : "Yes"
	]
	spawnflags(flags) =
	[
		1 : "OSCILLATOR" : 0 : "Instead of triggering the OnTimer output, will flip-flip between OnTimerHigh and OnTimerLow."
	]
	input Enable(void) : "Enable the timer logic."
	input Disable(void) : "Disable the timer logic."
	input Toggle(void) : "Toggle between Enable/Disable."
	input ResetTimer(void) : "Resets the timer, and starts it."
	input FireTimer(void) : "Forcefully triggers the OnTimer outputs."
	input AddToTimer(string) : "Adds the number of seconds from the data field to the current timer."
	input SubtractFromTimer(string) : "Removes the number of seconds from the data field to the current timer."
	output OnTimer(void) : "Triggered when the map is loaded for any reason."
	output OnTimerHigh(void) : "Triggered only when a new game starts on this level."
	output OnTimerLow(void) : "Triggered when the map is loaded via save game."
]

