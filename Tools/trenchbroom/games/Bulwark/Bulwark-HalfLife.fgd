	skidspeed(string) : "Skidspeed" : "" : "At which speed the vehicle starts skidding"
	traction(string) : "Traction" : "" : "Multiplier for the traction affecting the vehicle"
	breakfactor(string) : "Breakfactor" : "" : "Multiplier for the breaking mechanics"
	steerfactor(string) : "Steerfactor" : "" : "Multiplier for the steering speed"
	straightenfactor(string) : "Straightenfactor" : "" : "Multiplier for affecting the straightening mechanism"
	gravitydir(string) : "Gravitydir" : "" : "Normalized vector setting the direction of gravity Unimplemented:"
	sounds(string) : "Sounds" : "" : "A sound-set to use"
	volume(string) : "Volume" : "" : "Volume at which said sounds play at (from 0-10)"
