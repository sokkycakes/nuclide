@SolidClass base(NuclideIO, BrushCompile, BulwarkScripted) color(0 128 204) = func_door : "This sliding door entity has the ability to slide forth and back on any axis. It is often used for primitive elevators as well. Notes: The keys 'movesnd' and 'stopsnd' are obsolete. Their values point towards the samples doors/doormoveX.wav and doors/doorstopX.wav respectively, where X is the integer value set in 'movesnd' and 'stopsnd'. Previous documents referred to the SF_MOV_UNLINK (4) flag, which was a left-over from Quake."
[
	targetname(target_source) : "Targetname" : "" : "Name"
	target(target_destination) : "Target" : "" : "Target when triggered."
	killtarget(target_destination) : "Killtarget" : "" : "Target to kill when triggered."
	speed(string) : "Speed" : "" : "Movement speed in game-units per second."
	lip(string) : "Lip" : "" : "Sets how many units are still visible after a door moved."
	delay(string) : "Delay" : "" : "Time until triggering target."
	wait(string) : "Wait" : "" : "When to move back."
	netname(target_destination) : "Netname" : "" : "Target to trigger when door returns to its initial position."
	dmg(string) : "Dmg" : "" : "Damage to inflict upon anything blocking the way."
	snd_open(string) : "Snd open" : "" : "Sound shader to play for when the door opens."
	snd_close(string) : "Snd close" : "" : "Sound shader to play for when the door closes."
	snd_stop(string) : "Snd stop" : "" : "Sound shader to play for when the door stops moving."
	movesnd(string) : "Movesnd" : "" : "Legacy integer value pointing to a predefined move sound."
	stopsnd(string) : "Stopsnd" : "" : "Legacy integer value pointing to a predefined stop sound."
	forceclosed(string) : "Forceclosed" : "" : "Will make sure the door will not bounce back when something is blocking it"
	spawnflags(flags) =
	[
		1 : "SF_MOV_OPEN" : 0 : "Swaps the positions between raised and lowered state."
		4 : "SF_MOV_UNLINK" : 0 : "SF_MOV_UNLINK"
		8 : "SF_MOV_PASSABLE" : 0 : "Don't test against any collision with this door."
		32 : "SF_MOV_TOGGLE" : 0 : "Door cannot be opened by physical means, only by a trigger."
		256 : "SF_MOV_USE" : 0 : "Players can press the 'use' button/key to activate this door."
	]
]

