  enginepath_win32="C:/Users/sokky/Documents/Godot/bulwark_proto_funny/nuclide"
  engine_win32="fteqw64.exe"
  engine_linux="fteqw"
  basegame="base"
  basegamename="StilettoSwift"
  unknowngamename="Custom Quake modification"
  default_scale="1.0"
  no_patch="1"
  no_bsp_monitor="1"
  show_wads="1"
  archivetypes="pak wad"
  texturetypes="tga jpg mip hlw"
  modeltypes="mdl"
  maptypes="mapq1"
  shaders="quake3"
