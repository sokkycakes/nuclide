{
  "game": "stiletto",
  "title": "Stiletto Proto",
  "release_title": "Stiletto Proto playtest",
  "require": ["fteqw64.exe", "base.fmf", "base/progs.dat", "base/csprogs.dat", "base/menu.dat"],
  "include": [
    "fteqw64.exe",
    "*.dll",
    "base.fmf",
    "v8_context_snapshot.bin",
    "vk_swiftshader_icd.json",
    "resources/**",
    "base/**"
  ],
  "exclude": [
    "**/*.qc", "**/*.qh", "**/*.h", "**/*.src", "**/*.log", "**/*.bak", "**/*.new", "**/*.lnk",
    "**/Thumbs.db", "**/.DS_Store",
    "base/mapsrc/**", "base/modelsrc/**", "base/src/**", "base/saves/**", "base/tools/**",
    "base/PLUGINS", "base/PROJECT", "base/README.md", "base/FuncGodot.fgd",
    "base/*.png", "base/*.txt", "base/*.qwd.gz", "base/*.json",
    "base/_bench*.cfg", "base/lobby_*.cfg",
    "base/config.cfg", "base/fte.cfg", "base/conhistory.txt", "base/installed.lst",
    "base/**/autosave/**", "base/**/autosaves/**", "base/**/logs/**"
  ],
  "keep": [],
  "exec": [],
  "run": {
    "windows": {"exe": "fteqw64.exe", "args": ["-basedir", ".", "-manifest", "base.fmf"]}
  }
}
