/* File generated by Qt Creator / Qt Design Studio style project file */

import QmlProject 1.1

Project {
    mainFile: "main.qml"

    /* Include .qml files from this directory */
    QmlFiles {
        directory: "."
    }

    /* Include .js files */
    JavaScriptFiles {
        directory: "."
    }

    /* Include image files */
    ImageFiles {
        directory: "images"
    }

    Files {
        filter: "*.json"
        directory: "."
    }

    Files {
        filter: "*.ttf"
        directory: "fonts"
        recursive: true
    }

    /* Qt Design Studio needs the Studio DesignEffects import path */
    importPaths: [ "imports", "." ]
}
