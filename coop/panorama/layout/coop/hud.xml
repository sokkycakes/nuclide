<!--
	Justice Task Force in-game HUD, from sokky's Figma kit ("Example · HUD"
	on the Design System page; the components are described in
	styles/coop/hud.css). The co-op HUD progs (coop/src/hud/) opens this view
	embedded and draws it each frame it draws the HUD, posting "state" with
	everything shown. Positions are the Figma ones on the 1920x1080 frame.
-->
<root>
	<styles>
		<!-- the title menu's theme: only the variant's variables (see hud.css) -->
		<include src="file://{resources}/styles/qt/qtcurve-sokky-dark.css" />
		<include src="file://{resources}/styles/coop/hud.css" />
		<!-- WolfTeam's digit strip for the big numbers: a private file (not in
		     git, see hud.css "digits"); without it the numbers stay text -->
		<include src="file://{resources}/styles/coop/hud-wtdigits.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/coop/hud.js" />
	</scripts>

	<Panel id="Hud" class="hud QtCurve SokkyDark" hittest="false" bwdesignheight="900">
		<!-- squad: top-left, one Teammate card per other player -->
		<Panel id="Squad" class="squad" hittest="false" />

		<!-- wave counter: top centre -->
		<Panel id="Wave" class="wave-counter" hittest="false">
			<Label id="WaveTitle" class="hud-label accent" text="Wave 1" />
			<Label id="WaveLeft" class="hud-numeral" text="0" />
			<Label id="WaveCaption" class="hud-label muted" text="monsters left" />
		</Panel>

		<!-- kill feed: top-right, newest on top -->
		<Panel id="Feed" class="kill-feed" hittest="false" />

		<!-- notice: wave start, level up -->
		<Panel id="Notice" class="hud-notice" hittest="false">
			<Label id="NoticeTitle" class="notice-title" text="" />
			<Label id="NoticeSub" class="notice-sub" text="" />
		</Panel>

		<!-- respawn: while down, how long until fire brings you back -->
		<Panel id="Respawn" class="respawn hidden" hittest="false">
			<Panel class="bar-top">
				<Label id="RespawnLabel" class="hud-label bar-label" text="Respawning" />
				<Label id="RespawnValue" class="hud-label bar-value" text="" />
			</Panel>
			<Panel class="meter"><Panel id="RespawnFill" class="meter-fill" /></Panel>
			<Label id="RespawnHint" class="respawn-hint" text="A teammate can revive you" />
		</Panel>

		<!-- key prompt under the crosshair; for a pickup, a callout on the
		     item: a leader line from it up to the prompt, underlined -->
		<Panel id="Prompt" class="key-prompt" hittest="false">
			<Image id="PromptLeader" class="prompt-leader" src="file://{images}/coop/callout_leader.png" hittest="false" />
			<Panel id="PromptRow" class="prompt-row" hittest="false">
				<Panel id="PromptKeyBox" class="key-cap"><Label id="PromptKey" class="key-text" text="E" /></Panel>
				<Label id="PromptAction" class="prompt-action" text="" />
			</Panel>
		</Panel>

		<!-- target ID: the teammate or friendly under the crosshair, as a
		     squad card (src/client/nameplates.qc finds it) -->
		<Panel id="TargetID" class="mate target-id hidden" hittest="false">
			<Panel class="mate-top">
				<Label id="TargetName" class="mate-name" text="" />
				<Label id="TargetStatus" class="mate-status" text="Alive" />
				<Image id="TargetUp" class="mate-up hidden" src="file://{images}/coop/buff_up.png" hittest="false" />
			</Panel>
			<Panel class="meter"><Panel id="TargetFill" class="meter-fill" /></Panel>
		</Panel>

		<!-- vitals: bottom-left -->
		<Panel id="Vitals" class="vitals" hittest="false">
			<Panel id="Abilities" class="abilities" hittest="false" />
			<!-- Choir's Cadence buffing us (pips: how close to her cone's middle) -->
			<Panel id="Cadence" class="cadence hidden" hittest="false">
				<Label id="CadenceLabel" class="hud-label cadence-label" text="Cadence" />
				<Panel id="CadencePips" class="cadence-pips">
					<Panel class="cadence-pip" /><Panel class="cadence-pip" /><Panel class="cadence-pip" />
				</Panel>
			</Panel>
			<Panel id="ArmorBar" class="hud-bar success">
				<Panel class="bar-top">
					<Label id="ArmorLabel" class="hud-label muted bar-label" text="Barrier" />
					<Label id="ArmorValue" class="hud-label bar-value" text="0" />
				</Panel>
				<Panel class="meter"><Panel id="ArmorFill" class="meter-fill" /></Panel>
			</Panel>
			<Panel id="EnergyBar" class="hud-bar accent">
				<Panel class="bar-top">
					<Label class="hud-label muted bar-label" text="Energy" />
					<Label id="EnergyValue" class="hud-label bar-value" text="0 / 100" />
				</Panel>
				<!-- a tick at Engage's cost, shown once there's enough for it -->
				<Panel class="meter energy-meter"><Panel id="EnergyFill" class="meter-fill" /><Panel id="EngageTickRow" class="engage-tick-row hidden"><Panel id="EngageTickGap" class="engage-tick-gap" /><Panel class="engage-tick" /></Panel></Panel>
			</Panel>
			<!-- health at the bottom, level with the ammo (sokky 2026-11-02) -->
			<Panel id="HealthReadout" class="hud-readout" hittest="false">
				<!-- a plus for health (sokky 2026-11-02), two bars so it takes the
				     low-health colour -->
				<Panel class="icon-slot"><Panel class="plus-h" /><Panel class="plus-v" /></Panel>
				<Panel class="readout-text">
					<Label id="HealthValue" class="readout-value" text="100" />
					<Panel id="HealthValueDg" class="wtnum readout-value" hittest="false" />
				</Panel>
				<!-- a hero's Barrier: a blue number beside the health, only while
				     there is some (sokky 2026-11-02) -->
				<Panel id="BarrierReadout" class="readout-text barrier-readout hidden">
					<Label id="BarrierValue" class="readout-value barrier-value" text="0" />
					<Panel id="BarrierValueDg" class="wtnum readout-value barrier-value" hittest="false" />
				</Panel>
			</Panel>
		</Panel>

		<!-- weapons: bottom-right -->
		<Panel id="Weapons" class="weapons" hittest="false">
			<!-- a slot: the body, and on the weapon in hand an arrow tip on its left -->
			<Panel id="SlotStatic" class="weapon-slot static">
				<Panel class="slot-tip" />
				<Panel class="slot-body">
					<Label class="hud-label slot-key" text="1" />
					<Label id="SlotStaticName" class="slot-name" text="" />
				</Panel>
			</Panel>
			<Panel id="SlotDynamic" class="weapon-slot dynamic">
				<Panel class="slot-tip" />
				<Panel class="slot-body">
					<Label class="hud-label slot-key" text="2" />
					<Label id="SlotDynamicName" class="slot-name" text="" />
				</Panel>
			</Panel>
			<!-- the ammo at the bottom, level with the health; slots above -->
			<Panel id="Ammo" class="hud-ammo" hittest="false">
				<Label id="WeaponName" class="hud-label muted" text="" />
				<Panel class="ammo-counts">
					<Label id="Clip" class="ammo-clip" text="0" />
					<Panel id="ClipDg" class="wtnum ammo-clip" hittest="false" />
					<Panel id="AmmoDivider" class="ammo-divider" />
					<Label id="Reserve" class="ammo-reserve" text="0" />
					<Panel id="ReserveDg" class="wtnum ammo-reserve" hittest="false" />
				</Panel>
			</Panel>
		</Panel>
	</Panel>
</root>
