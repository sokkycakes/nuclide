// Justice Task Force: the ten prototype heroes (coop_heroes 1).
//
// From the example roster (two per genre). Each has one kit, "Standard".
// The kit's own gun (if any) is the dynamic slot; the primary is the
// static weapon (hero_primaries.def). Their abilities are rules code
// (coop/src/rules/hero_kits.qc), picked by "hero_logic". The keys
// below only name things for the HUD and the menu:
//   hero_logic  which ability set the rules run
//   hero_tool   the tool (C), or the passive resource when it has no key
//   hero_ab1    ability 1 (G)
//   hero_ab2    ability 2 (X)
//   hero_form   the henshin form (Z)
//   hero_ex     the form's exclusive move (V)
// The models are the three Quake Live stand-ins by weight.

// ---- Dispatch (Commander) -------------------------------------------
entityDef hero_dispatch
{
	"inherit"		"coop_hero_base"
	"hero_name"		"Dispatch"
	"hero_role"		"Commander"
	"hero_weight"	"mid"
	"hero_desc"		"Leads from the back: places orders that shield whoever follows them."
	"hero_kits"		"kit_dispatch"
	"hero_weapon"	"weapon_jtf_pdw"
	"hero_logic"	"dispatch"
	"hero_tool"		"Orders"
	"hero_ab1"		"Courier"
	"hero_ab2"		"Reroute"
	"hero_form"		"Operations"
	"hero_ex"		"Recall"
	"model"			"progs/ql/grunt_default.md2"
	"health"		"100"
	"max_health"	"100"
	"pm_walkspeed"	"260"
	"pm_crouchspeed"	"86"
}

entityDef kit_dispatch
{
	"inherit"		"hero_dispatch"
	"kit_name"		"Standard"
	"kit_desc"		"A burst PDW that's never the answer."
	"weapon"		"weapon_crowbar"
	"current_weapon"	"0"
}

