// Justice Task Force: the heroes' static weapons (coop_heroes 1).
//
// A hero has a static slot and a dynamic slot. The static weapon is the
// hero's own: given at every spawn, never dropped or replaced, its reserve
// (ammo_hero) never runs out, only the clip needs reloading. The dynamic
// slot holds one other gun; picking up another swaps it
// (coop/src/rules/heroes.qc). Melee and throwables are outside both.
//
// The models, sounds and textures are Counter-Strike Online's, from the
// CSNZ install, in zz_coopweapons.pk3, which isn't in git (coop/README.md).
// Their view models are drawn without arms: coop/tools/cso_hide_arms.py
// empties the "hands" body part. Stats are stand-ins until they're
// measured against CSNZ.

entityDef hero_weapon_base
{
	"inherit"			"weapon_base"
	"hudSlot"			"1"
	"hudSlotPos"		"4"
	"weight"			"30"
	"hero_static"		"1"
	"snd_empty"			"Weapons.Empty"
}

// ---- BALROG-VII (Tank) ----------------------------------------------------
// v_balrog7.mdl: 0 idle1, 1-2 shoot1/2, 3 shoot3 (the bigger muzzle flash of
// its explosive round), 4 reload (121 frames at 30 fps), 5 draw

entityDef weapon_balrog7
{
	"inherit"			"hero_weapon_base"
	"model"				"models/w_balrog7.mdl"
	"model_player"		"models/p_balrog7.mdl"
	"model_view"		"models/v_balrog7.mdl"
	"model_viewMirror"	"1"
	"animPrefix"		"mp5"
	"inv_name"			"BALROG-VII"

	"def_fireInfo"		"fireInfo_balrog7"
	"clipSize"			"120"
	"clipSizeDefault"	"120"

	"def_ejectBrass"	"debris_brass_fast"
	"ejectBrassDelay"	"0"
	"ejectBrassOffset"	"17 6 -8"

	"act_fire"			"1,2"
	"act_reload"		"4"
	"act_draw"			"5"
	"act_idle"			"0"

	"snd_fire"			"Weapon_Balrog7.Single"
}

entityDef fireInfo_balrog7
{
	"def_onFire"		"projectile_balrog7"
	"ammoType"			"ammo_hero"
	"ammoRequired"		"1"
	"ammoPerShot"		"1"
	"fireRate"			"0.1"
	"punchAngle"		"-1.5 0 0"
	"model_flash"		"sprites/muzzleflash1.spr"
}

entityDef projectile_balrog7
{
	"inherit"		"projectile_bullet_base"
	"damage"		"32"
	"spread"		"0.03 0.03"
}

