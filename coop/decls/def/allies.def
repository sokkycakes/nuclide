// Justice Task Force: friendly soldiers. monster_hecu_ally is a HECU grunt
// on the players' side, in place of Half-Life's Barney. It's a copy of
// monster_human_grunt (valve/decls/def/monsters/human_grunt.def), not an
// "inherit", so its animation events (the shots) come along for sure.
// Changes: team 0 like Barney; MP5 only, no grenades, which would land on
// the players it guards; follows on use; Barney's idle as its hunt too
// (the grunt's own hunt runs at the nearest player, and Barney's needs a
// TargetNearestEnemy input nothing handles), so it holds until it sees
// something.

entityDef monster_hecu_ally
{
	"spawnclass"	"ncTalkMonster"
	"model"			"models/hgrunt.mdl"
	"netname"		"HECU"
	"health"		"skill:hgrunt_health"
	"mins"			"-16 -16 0"
	"maxs"			"16 16 72"
	"eye_height"	"64"
	"team"			"0"
	"propdata"		"actor_human"
	"speed_walk"	"41"
	"speed_run"		"304"

	// melee attack
	"def_attack_melee"		"melee_hgrunt_kick"
	"attack_melee_range"	"96"
	"snd_melee_attack"		"HGrunt.Kick"

	// primary ranged attack
	"def_attack_ranged"		"ranged_hgrunt_mp5"
	"snd_ranged_attack"		"HGrunt.9MM"
	"attack_ranged_range"	"2048"
	"attack_ranged_dot"		"0.5"	// HL hgrunt.cpp CheckRangeAttack1
	"reload_count"			"30"

	"talk_answer"			"!HG_ANSWER"
	"talk_ask"				"!HG_QUEST"
	"talk_idle"				"!HG_IDLE"
	"snd_pain"				"HGrunt.Pain"
	"snd_death"				"HGrunt.Die"
	"snd_reload"			"HGrunt.Reload"
	"weapons"				"1"

	"follow_on_use"			"1"
	"mindset_follow"		"barney_follow"
	"mindset_idle"			"barney_idle"
	"mindset_defense"		"hgrunt_takeCover"
	"mindset_combat"		"hgrunt_combatFace"
	"mindset_hunt"			"barney_idle"

	"squad_leader_body"		"1:2"

	// grenade launcher
	when "weapons" contains 4 {
		"body1"					"4"
		"def_attack_special_1"	"projectile_hgrunt_ARgrenade"
		"skin"					"1"
	}

	// shotgun grunt
	when "weapons" contains 8 {
		"body2"				"2"
		"reload_count"		"8"
		"snd_ranged_attack"	"HGrunt.Shotgun"
		"def_attack_ranged"	"ranged_hgrunt_shot"
	}

	when "spawnflags" contains 32 {
		"squad_leader"		"1"
	}

	// animation event callbacks
	events {
		2 "StartSoundDef"	"HGrunt.Reload"
		3 "SpawnProjectileDef"	"melee_hgrunt_kick"
		4 "SpawnProjectileDef"	"ranged_hgrunt_mp5"
		5 "SpawnProjectileDef"	"ranged_hgrunt_mp5"
		6 "SpawnProjectileDef"	"ranged_hgrunt_mp5"
	}
}

