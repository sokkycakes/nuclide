// Justice Task Force: the prototype heroes' primaries (coop_heroes 1).
//
// Built on Half-Life's weapons for their behaviour (burst, pump, melee),
// with Counter-Strike Online's models and sounds, one per hero, from the
// CSNZ install, in zz_coopguns.pk3, which isn't in git (coop/README.md).
// View models have their arms hidden (tools/cso_hide_arms.py) and are
// mirrored like the other heroes' guns.
// Each is a static weapon: hudSlot 1, "hero_static",
// and the never-ending ammo_hero reserve (see hero_weapons.def). Only the
// feel is aimed at: burst, pump, slow and heavy, spray, charged. Numbers
// are first guesses.

// ---- Dispatch: compact burst PDW ------------------------------------------
entityDef weapon_jtf_pdw
{
	"inherit"			"weapon_9mmhandgun"
	"inv_name"			"Burst PDW"
	"def_fireInfo"		"fireInfo_jtf_pdw"
	"def_altFireInfo"	""
	"clipSize"			"30"
	"clipSizeDefault"	"30"
	"hudSlot"			"1"
	"hudSlotPos"		"4"
	"hero_static"		"1"
	// CSO mp7a1 (zz_coopguns.pk3, private): MP7A1 (carbine stock)
	"model"				"models/w_mp7a1.mdl"
	"model_player"		"models/p_mp7a1.mdl"
	"model_view"			"models/v_mp7a1.mdl"
	"model_viewMirror"	"1"
	"act_holster"		""
	"act_idle"			"6"
	"act_reload"		"7"
	"act_draw"		"8"
	"act_fire"		"9,10"
	"snd_fire"			"Weapon_JTF.PDW"
}

entityDef fireInfo_jtf_pdw
{
	"def_onFire"		"projectile_jtf_pdw"
	"ammoType"			"ammo_hero"
	"ammoRequired"		"1"
	"ammoPerShot"		"1"
	"fireRate"			"0.06"
	"burstCount"		"3"
	"burstTime"			"0.3"
	"punchAngle"		"-1 0 0"
	"model_flash"		"sprites/muzzleflash1.spr"
}

entityDef projectile_jtf_pdw
{
	"inherit"		"projectile_bullet_base"
	"damage"		"9"
	"spread"		"0.01 0.01"
}

