// Justice Task Force: the prototype heroes' primaries (coop_heroes 1).
//
// Stand-ins built on Half-Life's weapons so the ten example heroes
// (coop/heroes design, example-heroes.md) can be played before they have
// their own models. Each is a static weapon: hudSlot 1, "hero_static",
// and the never-ending ammo_hero reserve (see hero_weapons.def). Only the
// feel is aimed at: burst, pump, slow and heavy, spray, charged. Numbers
// are first guesses.

// ---- Dispatch: compact burst PDW ------------------------------------------
entityDef weapon_jtf_pdw
{
	"inherit"			"weapon_9mmhandgun"
	"inv_name"			"Burst PDW"
	"def_fireInfo"		"fireInfo_jtf_pdw"
	"def_altFireInfo"	""
	"clipSize"			"30"
	"clipSizeDefault"	"30"
	"hudSlot"			"1"
	"hudSlotPos"		"4"
	"hero_static"		"1"
}

entityDef fireInfo_jtf_pdw
{
	"def_onFire"		"projectile_jtf_pdw"
	"ammoType"			"ammo_hero"
	"ammoRequired"		"1"
	"ammoPerShot"		"1"
	"fireRate"			"0.06"
	"burstCount"		"3"
	"burstTime"			"0.3"
	"punchAngle"		"-1 0 0"
	"model_flash"		"sprites/muzzleflash1.spr"
}

entityDef projectile_jtf_pdw
{
	"inherit"		"projectile_bullet_base"
	"damage"		"9"
	"spread"		"0.01 0.01"
}

