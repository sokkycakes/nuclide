// Weapons and pickups that Sven Co-op maps hand out, for the co-op game.
// Stats follow Sven Co-op's published weapon numbers where we have them,
// and the maps' own scripts for their custom weapons. Models are the
// stock names, so a map's model list (or its own models) can replace them.

// 5.56mm ammo, for the M16
entityDef ammo_556
{
	"inherit"		"ammo_base"
	"model"			"models/w_9mmarclip.mdl"
	"inv_ammo_556"	"100"
}

// Sven Co-op's weaponbox, as a pickup: bullet9mm, buckshot, bullet556,
// uranium and the rest become inv_ammo_* keys (see weaponbox.lua)
entityDef item_sven_weaponbox
{
	"inherit"		"ammo_base"
	"model"			"models/w_weaponbox.mdl"
	"mins"			"-16 -16 0"
	"maxs"			"16 16 16"
}

