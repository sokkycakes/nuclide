// Team Fortress template: player classes.
//
// Every class is an entityDef named tfclass_<name> that inherits the base
// game's "player" def (model, animations) and spawns as tfPlayer. The rules
// register the classes listed in the tf_classes cvar for both teams, in that
// order, which also fills Nuclide's class menu.
//
// Stats are Team Fortress 2's health and speeds. Weapons are placeholders
// from the base game (Quake's arsenal) until the mod has its own; swap the
// "weapon" list for your own weapon defs.
//
// Template keys, read by tfPlayer and by bots:
//   tf_classIndex  1-9, class menu slot
//   tf_role        offense, defense, support or sniper (a hint for bots)
//   tf_capRate     how many players this class counts as on a point
//   tf_regen       health per second regenerated
//   tf_weaponRanges  "<weapon def> <min> <max> ..." effective ranges, best first
//
// Each class also has a tfclass_<name>_bot def that spawns as tfBotPawn, so a
// bot framework can give bots their own class without losing the stats.

entityDef tf_player_base
{
	"inherit"			"player"
	"spawnclass"		"tfPlayer"
	"armorProtection"	"0"
	"maxarmor"			"0"
	"pm_runfiring"		"1"
	"tf_capRate"		"1"
	"tf_regen"			"0"
}

entityDef tfclass_scout
{
	"inherit"			"tf_player_base"
	"tf_classIndex"		"1"
	"tf_role"			"offense"
	"health"			"125"
	"max_health"		"125"
	"pm_walkspeed"		"400"
	"pm_runspeed"		"400"
	"weapon"			"weapon_axe,weapon_nailgun,weapon_supershotgun"
	"current_weapon"	"2"
	"tf_weaponRanges"	"weapon_supershotgun 0 500 weapon_nailgun 0 1000 weapon_axe 0 64"
	"tf_capRate"			"2"
}

entityDef tfclass_scout_bot
{
	"inherit"		"tfclass_scout"
	"spawnclass"	"tfBotPawn"
}

entityDef tfclass_soldier
{
	"inherit"			"tf_player_base"
	"tf_classIndex"		"2"
	"tf_role"			"offense"
	"health"			"200"
	"max_health"		"200"
	"pm_walkspeed"		"240"
	"pm_runspeed"		"240"
	"weapon"			"weapon_axe,weapon_shotgun,weapon_rocketlauncher"
	"current_weapon"	"2"
	"tf_weaponRanges"	"weapon_rocketlauncher 150 1500 weapon_shotgun 0 600 weapon_axe 0 64"
}

entityDef tfclass_soldier_bot
{
	"inherit"		"tfclass_soldier"
	"spawnclass"	"tfBotPawn"
}

