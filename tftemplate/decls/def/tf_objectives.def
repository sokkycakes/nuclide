// Team Fortress template: objective and map entities.
//
// These map Team Fortress 2's entity classnames onto the template's classes,
// so maps (or maps/<map>.add overlays) can use TF2's keys and outputs. A def
// here overrides Nuclide's built-in class of the same name.
//
// Team keys use TF2 numbers: "TeamNum" 2 = RED, 3 = BLU, 0 = any.

entityDef item_teamflag
{
	"editor_usage"	"Flag (intelligence). TeamNum: owner. Enemies carry it to their func_capturezone."
	"editor_mins"	"-16 -16 0"
	"editor_maxs"	"16 16 48"
	"spawnclass"	"tfFlag"
}

entityDef func_capturezone
{
	"editor_usage"	"Volume where the TeamNum team scores carried flags."
	"spawnclass"	"tfCaptureZone"
}

entityDef team_control_point
{
	"editor_usage"	"Control point. Captured through a trigger_capture_area that names it."
	"editor_mins"	"-16 -16 0"
	"editor_maxs"	"16 16 32"
	"spawnclass"	"tfControlPoint"
}

entityDef trigger_capture_area
{
	"editor_usage"	"Volume in which players capture the point named by area_cap_point."
	"spawnclass"	"tfCaptureArea"
}

entityDef info_player_teamspawn
{
	"editor_usage"	"Spawn point for the TeamNum team."
	"editor_mins"	"-16 -16 -36"
	"editor_maxs"	"16 16 36"
	"spawnclass"	"tfTeamSpawn"
}

entityDef func_respawnroom
{
	"editor_usage"	"Players of TeamNum can change class instantly in here."
	"spawnclass"	"tfRespawnRoom"
}

entityDef func_regenerate
{
	"editor_usage"	"Resupply: refills health, armour and ammo of TeamNum players."
	"spawnclass"	"tfRegenerate"
}

// TF2 maps carry these; the template's rules do their jobs, so they are
// accepted and ignored instead of being reported as unknown.
entityDef team_control_point_master
{
	"spawnclass"	"info_null"
}

entityDef team_round_timer
{
	"editor_usage"	"The map's round clock: lengths for the rules, outputs as the round goes."
	"spawnclass"	"tfRoundTimer"
}

entityDef tf_gamerules
{
	"spawnclass"	"info_null"
}

entityDef tf_logic_koth
{
	"spawnclass"	"info_null"
}

// Payload (tf_pl). The cart is a func_tracktrain driven by a
// team_train_watcher; see src/server/tf_payload.qc.
entityDef func_tracktrain
{
	"editor_usage"	"Train that slides along path_tracks. Payload carts are driven by a team_train_watcher."
	"spawnclass"	"tfTrackTrain"
}

entityDef team_train_watcher
{
	"editor_usage"	"Turns the players at a payload cart into its speed."
	"spawnclass"	"tfTrainWatcher"
}

entityDef mapobj_cart_dispenser
{
	"editor_usage"	"Heals and resupplies TeamNum players in its touch_trigger."
	"spawnclass"	"tfCartDispenser"
}

entityDef dispenser_touch_trigger
{
	"editor_usage"	"The volume a mapobj_cart_dispenser serves."
	"spawnclass"	"tfDispenserTouch"
}

entityDef game_round_win
{
	"editor_usage"	"Input RoundWin ends the round for TeamNum."
	"spawnclass"	"tfRoundWin"
}

entityDef game_forcerespawn
{
	"editor_usage"	"ForceRespawn / ForceTeamRespawn bring dead players back now."
	"spawnclass"	"tfForceRespawn"
}

entityDef func_respawnroomvisualizer
{
	"editor_usage"	"Spawn room door wall, solid to the room's enemies."
	"spawnclass"	"tfRespawnVisualizer"
}

// Triggers with TF2's filters and outputs.
entityDef filter_activator_tfteam
{
	"spawnclass"	"tfFilterTeam"
}

entityDef filter_activator_name
{
	"spawnclass"	"tfFilterName"
}

entityDef filter_activator_class
{
	"spawnclass"	"tfFilterClass"
}

entityDef trigger_multiple
{
	"spawnclass"	"tfTrigger"
}

entityDef trigger_once
{
	"spawnclass"	"tfTriggerOnce"
}

entityDef trigger_hurt
{
	"spawnclass"	"tfTriggerHurt"
}

// Things TF2 maps carry that only matter to TF2's renderer or buildings.
entityDef func_nobuild
{
	"spawnclass"	"info_null"
}

entityDef env_tonemap_controller
{
	"spawnclass"	"info_null"
}

// Props from TF2's content are usually not installed: these hide them
// instead of showing the error model. Collision is kept by the engine (see
// scripts/propclip.txt).
entityDef prop_dynamic
{
	"spawnclass"	"tfPropDynamic"
}

entityDef prop_dynamic_override
{
	"spawnclass"	"tfPropDynamic"
}

entityDef prop_physics
{
	"spawnclass"	"tfPropPhysics"
}

entityDef prop_physics_override
{
	"spawnclass"	"tfPropPhysics"
}

entityDef prop_physics_multiplayer
{
	"spawnclass"	"tfPropPhysics"
}

entityDef trigger_catapult
{
	"editor_usage"	"Jump pad: throws players onto launchTarget."
	"spawnclass"	"tfTriggerCatapult"
}
