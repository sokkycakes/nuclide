// Team Fortress template: Team Fortress 2 style health kits and ammo packs.
//
// "tf_ammoFraction" is the share of each ammo type's maximum the pack
// refills; bots read it through TF_PickupAmount(). The "inv_ammo_*" keys
// below are that share of each maximum in ammo.def (rounded up), and need
// updating when the maximums change. Health kits use Nuclide's "inv_health".

entityDef tf_pickup_base
{
	"spawnclass"	"ncItem"
	"mins"			"-16 -16 0"
	"maxs"			"16 16 16"
	"snd_respawn"	"item.respawn"
	"respawn"		"10"
	"droptofloor"	"1"
	"pickupFlash"	"1"
}

entityDef item_healthkit_small
{
	"inherit"		"tf_pickup_base"
	"model"			"maps/b_bh10.bsp"
	"snd_acquire"	"health.pickup"
	"inv_health"	"25"
}

entityDef item_healthkit_medium
{
	"inherit"		"tf_pickup_base"
	"model"			"maps/b_bh25.bsp"
	"snd_acquire"	"health.pickup"
	"inv_health"	"60"
}

entityDef item_healthkit_full
{
	"inherit"		"tf_pickup_base"
	"model"			"maps/b_bh100.bsp"
	"snd_acquire"	"health.pickup"
	"inv_health"	"150"
}

