    // -- Sub-screens (overlay) -----------------------------------------------
    // active-screen: 0=main, 1=map picker, 2=mode picker, 3=options, 4=confirm

    // Map picker (active-screen == 1)
    Rectangle {
        visible: root.active-screen == 1;
        x: 0; y: 0; width: 100%; height: 100%;
        background: #000000CC;

        // Cancel button
        TouchArea {
            x: 0; y: 0; width: 100%; height: 100%;
            clicked => { root.map-picker-cancel(); }
        }

        Rectangle {
            x: root.sx(200); y: root.sy(100);
            width: root.sx(880); height: root.sy(520);
            background: #333333;

            Text {
                x: root.sx(20); y: root.sy(20);
                text: "SELECT MAP";
                color: #EAEEF8;
                font-size: root.sy(24);
                font-weight: 700;
            }

            // Preview area
            Rectangle {
                x: root.sx(540); y: root.sy(60);
                width: root.sx(320); height: root.sy(180);
                background: #555555;
                Text {
                    x: 10; y: 10;
                    text: root.map-preview-path;
                    color: #AAAAAA;
                    font-size: root.sy(14);
                }
            }

            // Up to 16 map entries in a scrollable area
            Rectangle {
                x: root.sx(20); y: root.sy(60);
                width: root.sx(500); height: root.sy(420);
                clip: true;
            }

            // Back button
            Rectangle {
                x: root.sx(20); y: root.sy(480);
                width: root.sx(200); height: root.sy(30);
                background: #555555;
                TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => { root.map-picker-cancel(); }
                }
                Text {
                    x: root.sx(30); y: root.sy(5);
                    text: "Back";
                    color: #EAEEF8;
                    font-size: root.sy(18);
                }
            }
        }
    }
