                text: "02";
                font-family: "04b24";
                font-size: root.sy(64);
                letter-spacing: root.sx(-5);
                color: @linear-gradient(180deg, #00000036 26.44%, #4B4B4B1A 100%);
            }
        }
    }

    // playerListSmall 3px gradient border (stroke drawn outside the clip)
    Rectangle {
        x: root.sx(891);
        y: root.sy(194);
        width: root.sx(288);
        height: root.sy(332);
        background: transparent;
        border-width: max(1px, root.sx(3));
        border-color: @linear-gradient(180deg, #333333 31.73%, #C2C2C200 100%);
    }

    // ?? lobbyPanelBanner ? node 19:286 ??
    Image { // stripe overlay (pattern6, in the banner's rotated space)
        x: root.sx(-14);
        y: root.sy(62);
        width: root.sx(117);
        height: root.sy(518);
        source: @image-url("../assets/stripes_banner.svg");
        image-fit: fill;
    }

    Text { // node 19:288 ? "Pregame Lobby", rotated -90? (reads bottom?top).
        // Box placed so that after rotation about its center it covers the
        // exact screen rect x 63.4..111.4, y 26.3..411.3 from the export.
        x: root.sx(87.4) - root.sy(385) / 2;
        y: root.sy(218.81) - root.sx(48) / 2;
        width: root.sy(385);
        height: root.sx(48);
        transform-rotation: -90deg;
        vertical-alignment: center;
        text: "Pregame Lobby";
        color: #EAEEF8;
        font-family: "Helvetica Extended BQ";
        font-size: root.sx(32);
    }

    // ?? frame top border (1px #C9C9C9) ? node 19:88 ??
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: max(1px, root.sy(1));
        background: #C9C9C9;
    }

    // -- Mouse hit-targets (Tier 1) --------------------------------------
    // Root-level so they share the focus bar's exact geometry (same x/width
    // and row-y), guaranteeing the hit area coincides with the highlight.
    // Hover moves the highlight; click activates. Rows 0-3 are inert; only
    // START GAME (4) fires its callback.
    TouchArea { // LOBBY OPTIONS
        x: root.sx(111); y: root.row-y(0); width: root.sx(452); height: root.sy(31);
        mouse-cursor: pointer;
        changed has-hover => { if (self.has-hover) { root.selected-index = 0; } }
        clicked => { root.selected-index = 0; }
    }
    TouchArea { // RULESET
        x: root.sx(111); y: root.row-y(1); width: root.sx(452); height: root.sy(31);
        mouse-cursor: pointer;
        changed has-hover => { if (self.has-hover) { root.selected-index = 1; } }
        clicked => { root.selected-index = 1; }
    }
    TouchArea { // MAP
        x: root.sx(111); y: root.row-y(2); width: root.sx(452); height: root.sy(31);
        mouse-cursor: pointer;
        changed has-hover => { if (self.has-hover) { root.selected-index = 2; } }
        clicked => { root.selected-index = 2; }
    }
    TouchArea { // SERVER TYPE
        x: root.sx(111); y: root.row-y(3); width: root.sx(452); height: root.sy(31);
        mouse-cursor: pointer;
        changed has-hover => { if (self.has-hover) { root.selected-index = 3; } }
        clicked => { root.selected-index = 3; }
    }
    TouchArea { // START GAME
        x: root.sx(111); y: root.row-y(4); width: root.sx(452); height: root.sy(31);
        mouse-cursor: pointer;
        changed has-hover => { if (self.has-hover) { root.selected-index = 4; } }
        clicked => { root.selected-index = 4; root.start-game(); }
    }
}
