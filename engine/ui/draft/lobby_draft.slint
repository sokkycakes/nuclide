// Pregame Lobby ? 1:1 port of Figma node 19:88 "16:9 v2" (1280 ? 720)
// https://www.figma.com/design/zPN8CD2bkg3IHbvJsTcNfA/?node-id=19-88
//
// Every coordinate, size, color and gradient stop is taken verbatim from the
// Figma SVG export (lobby_draft.svg). Element order matches the export's
// paint order, and grouping/names match the Figma layer tree (node ids in
// comments).
//
// Platform notes (no visual liberties taken ? these are baked equivalents):
//  - Elliptical/positioned radial gradients and tiled pattern fills are not
//    expressible in Slint, so they are baked into exact SVG assets
//    (lobby_bg.svg, mappreview_overlay.svg, stripes_*.svg) whose contents are
//    copied verbatim from the Figma export.
//  - Figma blend modes have no Slint equivalent; the composited result colors
//    were computed per the blend math and hard-coded:
//      * "color" blend  #B0D78C over blue plate  -> #70974C ? #355C11
//      * "color" blend  #910000 over blue plate  -> #E95757 ? #AE1D1D
//      * "color-burn" score digits on #D9D9D9    -> #ABABAB ? #D6D6D6
//      * "color-burn" score digits on plates     -> translucent black gradient
//  - Fonts as in Figma: "Trade Gothic Next LT Pro BdCn",
//    "TradeGothicLTW04-BdCnNo.20", "Helvetica Extended BQ", "Iosevka" (Heavy),
//    "04b24" (pixel score font). Fallbacks apply if not installed.
//
// Responsive: viewport-w / viewport-h are set from C each frame; everything
// scales proportionally from the 1280?720 reference, like title_menu.slint.

// keyStripe ? nodes 19:347 / 19:136 (#5B5B5B + 20% #666?#000 overlay,
// 2px #AFAFAF top/bottom edges)
component KeyStripeBG inherits Rectangle {
    in property <length> edge;

    background: #5B5B5B;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: @linear-gradient(180deg, #53535333 0%, #00000033 100%);
    }

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: root.edge;
        background: #AFAFAF;
    }

    Rectangle {
        x: 0;
        y: parent.height - root.edge;
        width: parent.width;
        height: root.edge;
        background: #AFAFAF;
    }
}

export component LobbyPanel inherits Window {
    callback start-game();
    callback back();
    callback toggle-ready();

    // Session state bound from FTEQW (m_slint_lobby.c)
    in-out property <string> host-name: "Player 1";
    in-out property <string> map-name: "MAPNAME";
    in-out property <string> ruleset: "DUEL";
    in-out property <string> server-type: "LISTEN SERVER";
    in-out property <string> room-code: "----";
    in-out property <string> status-text: "Waiting for host to start game...";
    in-out property <string> ready-label: "Ready";
    in-out property <string> player1-name: "Player1";
    in-out property <string> player2-name: "Player2";
    in-out property <string> player3-name: "Player3";
    in-out property <string> player4-name: "Player4";
    in-out property <int> player-count: 1;
    in-out property <int> max-players: 16;
    in-out property <int> is-host: 1;

    // Focused row (0=Ruleset 1=Map 2=ServerType 3=Start 4=Ready), driven by
    // m_slint_menu.c (keyboard/controller) and the per-row TouchAreas (mouse).
    in-out property <int> selected-index: 0;

    // Set from FTEQW each frame to match vid.width / vid.height
    in-out property <int> viewport-w: 1280;
    in-out property <int> viewport-h: 720;

    // Figma reference dimensions
    private property <int> ref-w: 1280;
    private property <int> ref-h: 720;

    pure function sx(v: float) -> length {
        return v * root.viewport-w * 1px / root.ref-w;
    }
    pure function sy(v: float) -> length {
        return v * root.viewport-h * 1px / root.ref-h;
    }

    // Root-space Y of a focusable row. Used by BOTH the highlight bar and the
    // mouse hit-areas so they can never drift apart.
    // Rows: 0=LOBBY OPTIONS 1=RULESET 2=MAP 3=SERVER TYPE 4=START GAME.
    pure function row-y(i: int) -> length {
        return i == 1 ? root.sy(277.0)
             : i == 2 ? root.sy(309.2)
             : i == 3 ? root.sy(340.3)
             : i == 4 ? root.sy(384.1)
             : root.sy(245.8);
    }
    pure function focus-y() -> length {
        return root.row-y(root.selected-index);
    }

    width: root.viewport-w * 1px;
    height: root.viewport-h * 1px;
    no-frame: true;
    background: #5C5C5C;

    // ?? bg ? node 19:375 (vertical #5C5C5C?#C2C2C2 + 41% elliptical radial) ??
    Image {
        x: 0;
        y: 0;
        width: root.sx(1280);
        height: root.sy(720);
        source: @image-url("../assets/lobby_bg.svg");
        image-fit: fill;
    }

    // ?? lobbypanelbg ? node 19:290 ??
    Rectangle {
        x: root.sx(0);
        y: root.sy(54);
        width: root.sx(650);
        height: root.sy(666);
        background: @linear-gradient(180deg, #272727C9 0%, #494949C9 89.9%);
    }

    // ?? keyStripe ? node 19:347 (full 650px stripe, behind the panel one) ??
    KeyStripeBG {
        x: root.sx(0);
        y: root.sy(589);
        width: root.sx(650);
        height: root.sy(46.4);
        edge: max(1px, root.sy(2));
    }

    // ?? focus ? node 19:382 ("LOBBY OPTIONS" selection bar) ??
    // Repurposed as the moving highlight: y tracks the focused row.
    Rectangle {
        x: root.sx(111);
        y: root.focus-y();
        width: root.sx(452);
        height: root.sy(34);
        background: @linear-gradient(90deg, #B70043 32.21%, #34343400 100%);

        Rectangle { // top accent (3px, 55% #FF8C8C ? transparent)
            x: 0;
            y: 0;
            width: parent.width;
            height: max(1px, root.sy(3));
            background: @linear-gradient(90deg, #FF8C8C8C 0%, #51000000 100%);
        }

        Rectangle { // left accent
            x: 0;
            y: 0;
            width: max(1px, root.sx(3));
            height: parent.height;
            background: #FF8C8C8C;
        }

        Rectangle { // bottom accent
            x: 0;
            y: parent.height - max(1px, root.sy(3));
            width: parent.width;
            height: max(1px, root.sy(3));
            background: @linear-gradient(90deg, #FF8C8C8C 0%, #51000000 100%);
        }
    }

    // ?? lobbypanel ? node 19:90 ??????????????????????????????????????????????

    // Container 19:91 bottom border (1px #40454E @ 85%)
    Rectangle {
        x: root.sx(109.969);
